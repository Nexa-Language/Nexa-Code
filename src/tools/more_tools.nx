// more_tools.nx — Phase 19 批次 2：更多 CC 工具
// python! 单 \n。

// ── LocalMemoryRecall (LocalMemoryRecallTool/) — session memory recall ──
@tool("Recall a memory from the session memory store. query: what to recall. Searches _CCPORT_MEMORY for relevant entries.")
fn LocalMemoryRecall(query: string): string {
    python! """
_q = (query or '').lower().strip()
_mem = globals().get('_CCPORT_MEMORY', [])
if not _mem:
    return 'No session memories stored.'
if not _q:
    return 'Session memories (%d):%s%s' % (len(_mem), chr(10), chr(10).join('  - %s' % m[:80] for m in _mem[-10:]))
_matches = [m for m in _mem if _q in m.lower()]
if not _matches:
    return 'No memories matching "%s".' % query
return 'Matching memories (%d):%s%s' % (len(_matches), chr(10), chr(10).join('  - %s' % m[:100] for m in _matches[:5]))
"""
}

// ── ListPeers (ListPeersTool/) — list connected peers (ACP stub) ──
@tool("List connected peers (agents via ACP). Returns peer list or notice that ACP is not configured.")
fn ListPeers(): string {
    python! """
_peers = globals().get('_CCPORT_PEERS', [])
if not _peers:
    return 'No peers connected. (ACP/teammate subsystem is a platform feature — Phase 5 out-of-scope.)'
return 'Peers (%d):%s%s' % (len(_peers), chr(10), chr(10).join('  - %s' % p.get('name', '?') for p in _peers))
"""
}

// ── SendUserFile (SendUserFileTool/) — send file to user ──
@tool("Send a file to the user. file_path: the file to send. Displays a local file reference; no upload occurs.")
fn SendUserFile(file_path: string): string {
    python! """
from nexa_code.tool_services import invoke
return invoke('SendUserFile', {'file_path': file_path})
"""
}

// ── RemoteTrigger — explicit webhook invocation with unknown-outcome recovery ──
@tool("Trigger a remote CI/CD pipeline or webhook. url: webhook URL. payload_json: JSON payload. Returns HTTP response or error.")
fn RemoteTrigger(url: string, payload_json: string): string {
    python! """
import json
from nexa_code.http_tools import request
_url = (url or '').strip()
if not _url:
    raise ValueError('url is required')
_response = request(_url, method='POST', payload=json.loads(payload_json) if payload_json else {}, timeout=30, limit=2000)
return 'Triggered %s (HTTP %d): %s' % (_url, _response['status'], _response['body'][:200])
"""
}

// ── Artifact (ArtifactTool/) — create/share artifact (local file) ──
@tool("Create a local artifact file (like CC cloud artifacts, but local). name: artifact name. content: text content. Saves to the runtime artifact store under .nexa-code/artifacts/.")
fn Artifact(name: string, content: string): string {
    python! """
from nexa_code.tool_services import invoke
return invoke('Artifact', {'name': name, 'content': content})
"""
}

// ── ReviewArtifact (ReviewArtifactTool/) — review an artifact ──
@tool("Review a previously created artifact. name: artifact name. Returns the artifact content.")
fn ReviewArtifact(name: string): string {
    python! """
from nexa_code.tool_services import invoke
return invoke('ReviewArtifact', {'name': name})
"""
}
