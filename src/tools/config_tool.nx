// config_tool.nx — ConfigTool（运行时读写 settings.json）
// Ported from ConfigTool/ schema: action=get|set|list, key, value.
@tool("Read or update Nexa Code settings: theme, editorMode, model/tool call budgets and timeout. action=get|set|list. Credentials and permissions require their explicit configuration paths.")
fn Config(action: string, key: string, value: string): string {
    python! """
from nexa_code.tool_services import invoke
return invoke('Config', {'action': action, 'key': key, 'value': value})
"""
}
