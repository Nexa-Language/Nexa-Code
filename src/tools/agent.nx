// =============================================================================
// agent.nx — Agent 工具（忠实移植 AgentTool，子 agent / Task）
// -----------------------------------------------------------------------------
// Ported from (唯一翻译源 refs/claude-code-ts):
//   packages/builtin-tools/src/tools/AgentTool/
//     - constants.ts:1-2            → 工具名 'Agent' (legacy 'Task')；VERIFICATION_AGENT_TYPE
//     - prompt.ts (getToolsDescription/formatAgentLine) → 子 agent 工具描述
//     - builtInAgents.ts + built-in/ → 内置 agent(Explore/Plan/GeneralPurpose/...)
//     - AgentTool.tsx (call) + runAgent.ts → 子 agent 执行（隔离上下文 + 查询循环）
//   src/constants/prompts.ts:713    → DEFAULT_AGENT_PROMPT（子 agent 默认人格）
// 忠实度：partial→full(核心)：subagent_type/prompt/description → 创建隔离上下文的子
//   NexaAgent（fresh messages）→ .run(prompt)（turn 循环映射 NexaAgent.run，**不手写循环**，
//   对齐 Phase 1 query_mapping）→ 返回子 agent 报告。
//   子 agent 工具集按 subagent_type：general-purpose=全部；Explore=只读(Read/Glob/Grep)；
//   其余/默认=general-purpose。fork/SendMessage 续跑/coordinator/memory 等平台特性未含(partial)。
//   子 agent 的工具调用同样经 execute_tool→PreToolUse 钩子（权限沿用）。
// python! 用单 \n（真换行）。
// =============================================================================

@tool("Launch a sub-agent with an isolated context to handle a sub-task. subagent_type: general-purpose (default, all tools) or explore (read-only: Read/Glob/Grep). prompt: the task for the sub-agent. description: a 3-5 word summary. The sub-agent runs to completion and returns a concise report; the caller relays it. Use for parallelizable independent work or to protect the main context from large outputs.")
fn Agent(subagent_type: string, prompt: string, description: string): string {
    python! """
from nexa_code.tool_services import invoke
return invoke('Agent', {'subagent_type': subagent_type, 'prompt': prompt, 'description': description})
"""
}
