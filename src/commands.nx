// =============================================================================
// commands.nx — 斜杠命令忠实移植（Phase 3）
// -----------------------------------------------------------------------------
// 每个命令 handler 忠实移植自 refs/claude-code-ts/src/commands/<name>/ 的核心行为。
// UI 渲染（Ink/React 弹窗、picker、对话框）是平台层细节，本移植对齐【命令行为】，
// 文本输出经 std.ui/print。命令经 main.nx flow 的 run_command 派发接入（对齐
// REPL.tsx:3967-4036 onSubmit 的「/ 开头→命令派发」）。
// 翻译源（逐命令）：
//   /help    ← commands/help/index.ts + help.tsx（HelpV2 列出命令）
//   /clear   ← commands/clear/clear.ts + conversation.ts:70-281（clearConversation：reset messages/readFileState/cost）
//   /compact ← commands/compact/compact.ts（compactConversation：摘要替换旧消息）
//   /model   ← commands/model/model.tsx（显示/切换模型）
//   /cost    ← commands/cost→usage（token/成本统计）
//   /status  ← commands/status/status.tsx（Settings>Status：cwd/model/git/config）
//   /exit    ← commands/exit/exit.tsx（gracefulShutdown）
//   /resume  ← commands/resume（列出/恢复会话）
//   /rewind  ← commands/rewind/rewind.ts（回退到某条消息）
//   /vim     ← commands/vim/vim.ts（切换 editorMode normal↔vim）
//   /fast    ← commands/fast/fast.tsx（切换 fastMode；Opus 专属）
//   /config  ← commands/config/config.tsx（显示/编辑 settings）
//   /context ← commands/context（显示 CLAUDE.md/git/env 上下文，复用 context.nx）
// 忠实度：见各 handler 备注（行为对齐；UI/会话存储/模型菜单等平台层项标 partial）。
// python! 用单 \n（真换行）；复合布尔在 python! 内；exit 经 "__CC_EXIT__" 哨兵返回。
// =============================================================================

// 派发斜杠命令。返回命令输出文本；/exit 返回 "__CC_EXIT__" 哨兵（flow 据此退出）。
@tool("Dispatch a slash command (Phase 3 + Phase 7). Returns output text; /exit returns __CC_EXIT__ sentinel; /init returns __AS_PROMPT__:... (flow routes to engine).")
fn run_command(cmd_line: string): string {
    python! """
import os

# --- 解析 命令名 + 参数 (REPL.tsx:4011-4018) ---
_line = (cmd_line or '').strip()
if _line.startswith('/'):
    _line = _line[1:]
_sp = _line.find(' ')
if _sp == -1:
    _name, _args = _line, ''
else:
    _name, _args = _line[:_sp], _line[_sp:].strip()

def _agent():
    return globals().get('Coder')

# --- /help: commands/help (HelpV2 列出命令) ---
def _help():
    _cmds = [
        ('/help', 'Show help and available commands'),
        ('/clear', 'Clear conversation history and free up context'),
        ('/compact [instructions]', 'Clear conversation history but keep a summary'),
        ('/model', 'Show / switch the current model'),
        ('/cost', 'Show token usage and cost'),
        ('/status', 'Show account/session status (cwd, model, git)'),
        ('/context', 'Show the assembled context (CLAUDE.md, git, env)'),
        ('/config', 'Show config / settings'),
        ('/vim', 'Toggle editor mode (normal <-> vim)'),
        ('/fast', 'Toggle fast mode (Opus-specific; note under GLM)'),
        ('/rewind', 'Rewind to a previous message'),
        ('/resume', 'Resume a previous session'),
        ('/init', 'Analyze repo and create CLAUDE.md (agent-driven)'),
        ('/doctor', 'Diagnose installation and settings'),
        ('/add-dir <path>', 'Add a working directory'),
        ('/memory', 'Show CLAUDE.md memory file hierarchy'),
        ('/permissions', 'Show allow/deny permission rules and mode'),
        ('/agents', 'List configured agents'),
        ('/mcp', 'Show configured MCP servers'),
        ('/copy', 'Copy last assistant reply to clipboard'),
        ('/usage', 'Detailed token/cost statistics'),
        ('/export', 'Export conversation to markdown file'),
        ('/undo', 'Undo last file edit (restore snapshot)'),
        ('/review', 'Show git diff for code review'),
        ('/share', 'Share conversation as markdown file'),
        ('/git <sub>', 'Git: status|log|branch|blame|stash|diff|cherry-pick|merge|push|pull'),
        ('/pr', 'Create a PR (git push + gh pr create)'),
        ('/login', 'Show API key / provider configuration'),
        ('/feedback', 'Record user feedback'),
        ('/keybindings', 'Show keyboard shortcuts'),
        ('/release-notes', 'Show version history'),
        ('/screenshot', 'Capture terminal screenshot'),
        ('/terminal-setup', 'Terminal integration tips'),
        ('/bug', 'Report a bug'),
        ('/install <pkg>', 'Install a package (pip/bun)'),
        ('/plugin', 'Plugin management info'),
        ('/exit', 'Exit the REPL'),
    ]
    _lines = ['Available commands:']
    for _c, _d in _cmds:
        _lines.append('  %s - %s' % (_c, _d))
    return '\n'.join(_lines)

# --- /clear: clear/clear.ts + conversation.ts:130,160 (深化版 — 对齐 CC clearConversation) ---
# CC: commands/clear/clear.ts → clearConversation: reset messages + readFileState + token/cost counters
def _clear():
    _a = _agent()
    if _a is None:
        return 'No agent.'
    _a.messages = [{'role': 'system', 'content': _a.system_prompt}]
    globals().get('_CCPORT_READ_STATE', {}).clear()
    globals()['_CCPORT_TOKENS_IN'] = 0
    globals()['_CCPORT_TOKENS_OUT'] = 0
    globals().get('_CCPORT_FILE_HISTORY', {}).clear()
    globals().get('_CCPORT_TODOS', {}).clear()
    return 'Conversation cleared. Context freed. (messages + readFileState + tokens + file history + todos reset)'

# --- /compact: compact/compact.ts (compactConversation: 深化版，对齐 CC 算法) ---
# CC: compactConversation(complex.ts:411-660) + getCompactPrompt(prompt.ts:293) +
#     formatCompactSummary(prompt.ts:311) + getCompactUserSummaryMessage(prompt.ts:337) +
#     buildPostCompactMessages(compact.ts:336) + messagesToKeep 保留近 N 条
def _compact():
    _a = _agent()
    if _a is None:
        return 'No agent.'
    _msgs = [m for m in _a.messages if m.get('role') in ('user', 'assistant')]
    if len(_msgs) < 4:
        return 'No messages to compact'
    import re as _re
    # CC compact.ts: 分组保留近 4 条消息（对齐 groupMessagesByApiRound 的 keep-recent）
    _keep = _msgs[-4:]
    _sum_msgs = _msgs[:-4]
    if len(_sum_msgs) < 2:
        return 'Too few messages to compact (need >4 after keeping recent 4).'
    _transcript = chr(10).join('[%s] %s' % (m.get('role'), str(m.get('content'))[:600]) for m in _sum_msgs)
    # CC prompt.ts getCompactPrompt: BASE_COMPACT_PROMPT 9-section + custom instructions
    _compact_prompt = (
        'Your task is to create a detailed summary of the conversation so far, '
        'paying close attention to the user explicit requests and your previous actions. '
        'This summary should be thorough in capturing technical details, code patterns, '
        'and architectural decisions that would be essential for continuing development work without losing context.'
        + chr(10) + chr(10) +
        'Your summary should include the following sections:' + chr(10) + chr(10) +
        '1. Primary Request and Intent' + chr(10) +
        '2. Key Technical Concepts' + chr(10) +
        '3. Files and Code Sections' + chr(10) +
        '4. Errors and fixes' + chr(10) +
        '5. Problem Solving' + chr(10) +
        '6. All user messages' + chr(10) +
        '7. Pending Tasks' + chr(10) +
        '8. Current Work' + chr(10) +
        '9. Optional Next Step'
    )
    if _args and _args.strip():
        _compact_prompt = _compact_prompt + chr(10) + chr(10) + 'Additional Instructions:' + chr(10) + _args
    try:
        _client = _a._get_client()
        _resp = _client.chat.completions.create(
            model=_a.model, timeout=90,
            messages=[{'role': 'system', 'content': _compact_prompt},
                      {'role': 'user', 'content': _transcript}])
        _raw = _resp.choices[0].message.content or '(empty summary)'
        # CC formatCompactSummary: strip <analysis>, extract <summary> content
        _summary = _re.sub(r'<analysis>.*?</analysis>', '', _raw, flags=_re.DOTALL).strip()
        _m = _re.search(r'<summary>(.*?)</summary>', _summary, _re.DOTALL)
        if _m:
            _summary = 'Summary:' + chr(10) + _m.group(1).strip()
        _summary = _re.sub(r'\n\n+', chr(10) + chr(10), _summary).strip()
        # CC getCompactUserSummaryMessage: framing + transcript path + "recent preserved"
        _framed = ('This session is being continued from a previous conversation that ran out of context. '
                   'The summary below covers the earlier portion of the conversation.' + chr(10) + chr(10) + _summary
                   + chr(10) + chr(10) + 'Recent messages are preserved verbatim.')
        # CC buildPostCompactMessages: system + summary_user + ack + recent_kept
        _sys = [m for m in _a.messages if m.get('role') == 'system']
        _a.messages = _sys + [
            {'role': 'user', 'content': _framed},
            {'role': 'assistant', 'content': 'Understood. I have the summary and the recent messages are preserved.'}
        ] + _keep
        return 'Compacted: %d messages -> CC 9-section summary + kept last 4.' % len(_msgs)
    except Exception as _e:
        return 'Compact failed: %s' % _e

# --- /model: model/model.tsx (深化版 — 对齐 CC: 运行时切换 + 持久化到 settings) ---
# CC: commands/model/model.tsx → ModelPicker (interactive) + config persistence via updateSettingsForSource
# 深化：切换时持久化到 secrets.nxs MODEL_NAME.default + 列出可用模型（从 secrets.nxs）
def _model():
    _a = _agent()
    if not _a:
        return '(no agent)'
    if _args:
        _new = _args.strip().split()[0]
        _a.model = _new
        for _attr in ('_client', '_client_cache', '__client_cache__'):
            if hasattr(_a, _attr):
                try:
                    setattr(_a, _attr, None)
                except Exception:
                    pass
        # CC model.tsx persists to settings; we persist to secrets.nxs MODEL_NAME
        try:
            import os as _os, re as _re
            _sf = _os.path.join(_os.getcwd(), 'secrets.nxs')
            if _os.path.isfile(_sf):
                with open(_sf, 'r', encoding='utf-8') as _f:
                    _content = _f.read()
                _content = _re.sub(r'"default":\s*"[^"]*"', '"default": "%s"' % _new, _content)
                _content = _re.sub(r'"strong":\s*"[^"]*"', '"strong": "%s"' % _new, _content)
                _content = _re.sub(r'"weak":\s*"[^"]*"', '"weak": "%s"' % _new, _content)
                with open(_sf, 'w', encoding='utf-8') as _f:
                    _f.write(_content)
        except Exception:
            pass
        return 'Model switched to: %s (next turn uses it; persisted to secrets.nxs).' % _new
    # 列出可用模型（从 secrets.nxs MODEL_NAME）
    import os as _os, re as _re
    _models = []
    _sf = _os.path.join(_os.getcwd(), 'secrets.nxs')
    if _os.path.isfile(_sf):
        try:
            with open(_sf, 'r', encoding='utf-8') as _f:
                _c = _f.read()
            for _m in _re.findall(r'"(glm-[\w.]+)"', _c):
                if _m not in _models:
                    _models.append(_m)
        except Exception:
            pass
    _avail = ''
    if _models:
        _avail = chr(10) + 'Available: ' + ', '.join(_models)
    return 'Current model: %s%s%s' % (_a.model, _avail, chr(10) + 'Usage: /model <name> to switch (e.g. /model glm-5.1; must have quota).')

# --- /cost: cost->usage (深化版 — 对齐 CC usage: token 估算 + ctx window% + model) ---
# CC: commands/cost→usage (token/cost statistics with context window usage)
def _cost():
    _a = _agent()
    _msgs = _a.messages if _a else []
    _u = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'user')
    _as = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'assistant')
    _s = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'system'
    _total = _u + _as + _s
    _cjk = sum(1 for _c in str(_msgs) if chr(0x4e00) <= _c <= chr(0x9fff))
    _est = int(_cjk * 0.5 + (_total - _cjk) * 0.25)
    _ctx_pct = min(100, (_est * 100) // 200000)
    _real_in = globals().get('_CCPORT_TOKENS_IN', 0)
    _real_out = globals().get('_CCPORT_TOKENS_OUT', 0)
    _lines = ['Usage:',
              '  Model: %s' % (_a.model if _a else '?'),
              '  Messages: %d (system=%d, user=%d, assistant=%d)' % (len(_msgs), 1 if _s else 0, sum(1 for m in _msgs if m.get('role')=='user'), sum(1 for m in _msgs if m.get('role')=='assistant')),
              '  Estimated tokens: %d (ctx %d%% of 200K)' % (_est, _ctx_pct)]
    if _real_in or _real_out:
        _lines.append('  Real tokens: in=%d, out=%d, total=%d' % (_real_in, _real_out, _real_in + _real_out))
    return chr(10).join(_lines)

# --- /status: status (深化版 — 对齐 CC Settings>Status: mode + tools + elapsed + compact) ---
# CC: commands/status/status.tsx → Settings defaultTab="Status" (interactive panel)
# CC Status shows: model, plan/account/org, cwd, permission mode, tool count, token/cost/time
def _status():
    import subprocess, time as _t
    _a = _agent()
    _cwd = os.getcwd()
    _branch = ''
    _dirty = False
    try:
        _b = subprocess.run(['git', 'branch', '--show-current'], capture_output=True, text=True, timeout=5)
        _branch = (_b.stdout or '').strip()
        _d = subprocess.run(['git', 'status', '--porcelain'], capture_output=True, text=True, timeout=5)
        _dirty = bool((_d.stdout or '').strip())
    except Exception:
        pass
    _mode = globals().get('_CCPORT_MODE', 'default')
    _ntools = len([k for k in LOCAL_TOOLS if not k.startswith('_')])
    _msgs = _a.messages if _a else []
    _chars = sum(len(str(m.get('content', ''))) for m in _msgs)
    _est = _chars // 4
    _lines = ['Status:',
              '  Model: %s' % (_a.model if _a else '(none)'),
              '  Working directory: %s' % _cwd,
              '  Git: %s%s' % (_branch or '(none)', ' *' if _dirty else ''),
              '  Permission mode: %s' % _mode,
              '  Tools: %d' % _ntools,
              '  Messages: %d | Est tokens: %d (ctx %d%%)' % (len(_msgs), _est, min(100, (_est * 100) // 200000))]
    return chr(10).join(_lines)

# --- /context: context (显示 CLAUDE.md/git/env，复用 context.nx) ---
def _context():
    try:
        return build_user_context(_agent().model if _agent() else 'glm-4-flash')
    except Exception as _e:
        return 'Context error: %s' % _e

# --- /config: config/config.tsx (显示 settings) ---
# --- /config: config (深化版 — 对齐 CC getInitialSettings + updateSettingsForSource) ---
# CC: commands/config/config.tsx → Settings/Config.tsx (interactive picker)
# + utils/settings/settings.ts:309 getSettingsForSource / :416 updateSettingsForSource / :812 getInitialSettings
# 深化：get/set/list/edit 子命令，多源合并读取（user→project→local），持久化写入 settings.local.json
def _config():
    import json as _j
    _home = os.path.expanduser('~')
    _sources = [
        ('user', os.path.join(_home, '.claude', 'settings.json')),
        ('project', os.path.join(os.getcwd(), '.claude', 'settings.json')),
        ('local', os.path.join(os.getcwd(), '.claude', 'settings.local.json')),
    ]
    _parts = (_args or '').strip().split(None, 2)
    if not _parts or _parts[0] == 'list':
        _merged = {}
        _lines = ['Config (merged from all sources):']
        for _src_name, _src_path in _sources:
            if os.path.isfile(_src_path):
                try:
                    with open(_src_path, 'r', encoding='utf-8') as _f:
                        _data = _j.load(_f) or {}
                    _merged.update(_data)
                    _lines.append('  [%s] %s (%d keys)' % (_src_name, _src_path, len(_data)))
                except Exception:
                    pass
        if _merged:
            _lines.append('')
            _lines.append('Effective settings:')
            for _k in sorted(_merged.keys()):
                _lines.append('  %s: %s' % (_k, _j.dumps(_merged[_k], ensure_ascii=False)[:100]))
        else:
            _lines.append('  (no settings files found; using built-in defaults)')
        _lines.append('')
        _lines.append('Usage: /config [get|set|list] [key] [value]')
        return chr(10).join(_lines)
    _action = _parts[0].lower()
    if _action == 'get' and len(_parts) >= 2:
        _key = _parts[1]
        for _src_name, _src_path in _sources:
            if os.path.isfile(_src_path):
                try:
                    with open(_src_path, 'r', encoding='utf-8') as _f:
                        _data = _j.load(_f) or {}
                    if _key in _data:
                        return '%s = %s (from %s)' % (_key, _j.dumps(_data[_key], ensure_ascii=False), _src_name)
                except Exception:
                    pass
        return '%s = (not set)' % _key
    if _action == 'set' and len(_parts) >= 3:
        _key = _parts[1]
        _val = _parts[2]
        _target = os.path.join(os.getcwd(), '.claude', 'settings.local.json')
        _data = {}
        os.makedirs(os.path.dirname(_target), exist_ok=True) if os.path.dirname(_target) else None
        if os.path.isfile(_target):
            try:
                with open(_target, 'r', encoding='utf-8') as _f:
                    _data = _j.load(_f) or {}
            except Exception:
                _data = {}
        try:
            _parsed = _j.loads(_val)
        except Exception:
            _parsed = _val
        _data[_key] = _parsed
        with open(_target, 'w', encoding='utf-8') as _f:
            _j.dump(_data, _f, ensure_ascii=False, indent=2)
        return 'Set %s = %s (saved to %s)' % (_key, _j.dumps(_parsed, ensure_ascii=False), _target)
    return 'Usage: /config [list|get <key>|set <key> <value>]'

# --- /vim: vim/vim.ts (切换 editorMode normal<->vim) ---
def _vim():
    _cfg = globals().setdefault('_CCPORT_GLOBAL_CONFIG', {})
    _cur = _cfg.get('editorMode', 'normal')
    if _cur == 'emacs':
        _cur = 'normal'
    _new = 'vim' if _cur == 'normal' else 'normal'
    _cfg['editorMode'] = _new
    if _new == 'vim':
        return 'Editor mode set to vim. Use Escape key to toggle between INSERT and NORMAL modes.'
    return 'Editor mode set to normal. Using standard (readline) keyboard bindings.'

# --- /fast: fast/fast.tsx (切换 fastMode；Opus 专属) ---
def _fast():
    _cfg = globals().setdefault('_CCPORT_GLOBAL_CONFIG', {})
    _cur = bool(_cfg.get('fastMode', False))
    _cfg['fastMode'] = not _cur
    _state = 'enabled' if (not _cur) else 'disabled'
    _note = ('Fast mode uses the same frontier model with faster output (Opus-specific). '
             'Under the GLM runtime, fast mode has no model effect; flag toggled for parity.')
    return 'Fast mode %s. %s' % (_state, _note)

# --- /rewind: rewind (深化版 — 对齐 CC rewind: 消息列表 + 内容搜索 + 数值回退) ---
# CC: commands/rewind/rewind.ts → openMessageSelector (UI picker)
# CC rewind command itself is thin — actual logic is in UI (LogSelector).
# 深化：list 显示消息索引、search 按内容查找、数字回退保留。
def _rewind():
    _a = _agent()
    if _a is None:
        return 'No agent.'
    _arg = (_args or '').strip()
    _msgs = _a.messages
    _rest = [_m for _m in _msgs if _m.get('role') != 'system']

    if _arg == 'list' or _arg == '':
        if not _rest:
            return 'No messages to rewind.'
        _lines = ['Messages (%d, oldest first):' % len(_rest)]
        for _i, _m in enumerate(_rest):
            _role = _m.get('role', '?')
            _text = str(_m.get('content', ''))[:60].replace(chr(10), ' ')
            _lines.append('  [%d] %s: %s' % (_i + 1, _role, _text))
        _lines.append(chr(10) + 'Usage: /rewind <n> to drop last n turns, or /rewind search <query>')
        return chr(10).join(_lines)

    if _arg.startswith('search '):
        _q = _arg[7:].lower()
        _matches = []
        for _i, _m in enumerate(_rest):
            if _q in str(_m.get('content', '')).lower():
                _matches.append('  [%d] %s: %s' % (_i + 1, _m.get('role', '?'), str(_m.get('content', ''))[:60].replace(chr(10), ' ')))
        if not _matches:
            return 'No messages matching "%s".' % _q
        return 'Matches (%d):' % len(_matches) + chr(10) + chr(10).join(_matches)

    if _arg.lstrip('-').isdigit():
        _n = int(_arg)
        _kept = [_m for _m in _msgs if _m.get('role') == 'system']
        if _n >= len(_rest):
            _a.messages = _kept
            return 'Rewound: cleared all non-system messages.'
        _drop = _n * 2
        if _drop > len(_rest):
            _drop = len(_rest)
        _a.messages = _kept + _rest[:len(_rest) - _drop]
        return 'Rewound %d turn(s), %d messages remaining.' % (_n, len(_a.messages) - len(_kept))

    return 'Usage: /rewind [list|search <query>|<n>]'

# --- /resume: resume (深化版 — 对齐 CC resume.tsx: session 列表 + 选择 + 恢复) ---
# CC: commands/resume/resume.tsx → LogSelector (interactive picker)
# + utils/sessionStorage.ts: listSessions + loadFullLog + readTranscriptForLoad
# 深化：列出 sessions + 按 ID/路径恢复（调用 harness.nx load_session）
def _resume():
    _arg = (_args or '').strip()
    if not _arg or _arg == 'list':
        _listing = list_sessions()
        if 'No saved' in _listing or not _listing.strip():
            return 'No previous sessions found.\nUse /clear for a fresh session or save one with the session being compacted/ended.'
        return 'Available sessions:\n' + _listing
    # CC resume with arg: load specific session by path or ID
    try:
        _result = load_session(_arg)
        return _result
    except Exception as _e:
        return 'Resume failed: %s\nRun /resume to list available sessions.' % _e

# --- /exit: exit/exit.tsx (gracefulShutdown) ---
def _exit():
    return '__CC_EXIT__'

# --- /init: init.ts (NEW_INIT_PROMPT, local-prompt → agent 调研+写 CLAUDE.md) ---
def _init():
    _p = (
        "Set up a minimal CLAUDE.md for this repo. CLAUDE.md loads into every session, so keep it concise — only what Claude would get wrong without it. "
        "Steps: (1) survey the codebase — read manifest files (package.json / pyproject.toml / Cargo.toml / go.mod / etc.), README, Makefile / build configs, CI config, existing CLAUDE.md. "
        "(2) write a concise CLAUDE.md with non-obvious commands, gotchas, branch/PR conventions, required env setup, testing quirks. "
        "Do NOT include obvious instructions (error messages / unit tests / no secrets). Use the Write tool to create CLAUDE.md."
    )
    return '__AS_PROMPT__:' + _p

# --- /doctor: doctor (诊断安装/设置) ---
def _doctor():
    import json as _j, os as _os, sys as _sys
    _a = globals().get('Coder')
    try:
        _mc = _j.loads(_mcp_load_config())
    except Exception:
        _mc = {}
    _st = globals().get('_CCPORT_RULES', {})
    _lines = ['Doctor:']
    _lines.append('  model: %s' % (_a.model if _a else '(none)'))
    _lines.append('  cwd: %s' % _os.getcwd())
    _lines.append('  secrets.nxs: %s' % ('found' if _os.path.isfile('secrets.nxs') else 'MISSING'))
    _lines.append('  .claude/settings.local.json: %s' % ('found' if _os.path.isfile('.claude/settings.local.json') else 'none'))
    _lines.append('  MCP servers configured: %d %s' % (len(_mc), list(_mc.keys())))
    _lines.append('  permission rules: allow=%d deny=%d ask=%d' % (len(_st.get('allow', [])), len(_st.get('deny', [])), len(_st.get('ask', []))))
    _lines.append('  permission mode: %s' % globals().get('_CCPORT_MODE', 'default'))
    _lines.append('  python: %s' % _sys.version.split()[0])
    _lines.append('  agent messages: %d' % (len(_a.messages) if _a else 0))
    return chr(10).join(_lines)

# --- /add-dir <path>: add-dir (添加工作目录) ---
def _add_dir():
    if not _args:
        return 'Usage: /add-dir <path>'
    import os as _os
    _ap = _os.path.abspath(_args.split()[0])
    _d = globals().setdefault('_CCPORT_ADD_DIRS', [])
    if _ap not in _d:
        _d.append(_ap)
    return 'Added working directory: %s (total: %d)' % (_ap, len(_d))

# --- /memory: memory (列出 CLAUDE.md 层级 memory 文件) ---
def _memory():
    import os as _os
    _home = _os.path.expanduser('~')
    _files = [
        (_os.path.join(_home, '.claude', 'CLAUDE.md'), 'user (global)'),
        (_os.path.join(_os.getcwd(), 'CLAUDE.md'), 'project'),
        (_os.path.join(_os.getcwd(), '.claude', 'CLAUDE.md'), 'project (.claude/)'),
    ]
    _lines = ['Memory files (CLAUDE.md hierarchy):']
    for _p, _tag in _files:
        _ex = 'exists' if _os.path.isfile(_p) else 'missing'
        _lines.append('  [%s] %s — %s' % (_tag, _p, _ex))
    _lines.append('Edit with your $EDITOR or the Edit tool.')
    return chr(10).join(_lines)

# --- /permissions: permissions (深化版 — 对齐 CC PermissionRuleList: add/remove/list + 持久化) ---
# CC: commands/permissions/permissions.tsx → PermissionRuleList (interactive)
# + utils/permissions/permissionsLoader.ts addPermissionRulesToSource (persist to settings)
# + utils/permissions/permissionSetup.ts (mode switching)
def _permissions():
    _st = globals().get('_CCPORT_RULES', {'allow': [], 'deny': [], 'ask': []})
    _mode = globals().get('_CCPORT_MODE', 'default')
    _parts = (_args or '').strip().split(None, 2)
    if not _parts or _parts[0] == 'list':
        _lines = ['Permission rules (mode=%s):' % _mode,
                  '  allow (%d): %s' % (len(_st.get('allow', [])), _st.get('allow', [])),
                  '  deny  (%d): %s' % (len(_st.get('deny', [])), _st.get('deny', [])),
                  '  ask   (%d): %s' % (len(_st.get('ask', [])), _st.get('ask', [])),
                  'Usage: /permissions [add|remove] [allow|deny|ask] <rule>']
        return chr(10).join(_lines)
    _action = _parts[0].lower()
    if _action in ('add', 'remove') and len(_parts) >= 3:
        _behavior = _parts[1].lower()
        _rule = _parts[2]
        if _behavior not in ('allow', 'deny', 'ask'):
            return 'Invalid behavior: %s (use allow|deny|ask)' % _behavior
        if _action == 'add':
            if _rule not in _st.get(_behavior, []):
                _st.setdefault(_behavior, []).append(_rule)
                globals()['_CCPORT_RULES'] = _st
            return 'Added rule: %s %s' % (_behavior, _rule)
        if _action == 'remove':
            if _rule in _st.get(_behavior, []):
                _st[_behavior].remove(_rule)
                globals()['_CCPORT_RULES'] = _st
                return 'Removed rule: %s %s' % (_behavior, _rule)
            return 'Rule not found: %s %s' % (_behavior, _rule)
    return 'Usage: /permissions [list|add|remove] [allow|deny|ask] <rule>'

# --- /agents: agents (列出已配置 agent) ---
def _agents():
    _a = globals().get('Coder')
    _lines = ['Agents:']
    _lines.append('  Coder (main, model=%s, tools=14)' % (_a.model if _a else '?'))
    _lines.append('  Built-in subagent types (Agent tool):')
    _lines.append('    general-purpose — all tools, isolated context')
    _lines.append('    explore — read-only (Read/Glob/Grep)')
    _lines.append('  (CC also has: plan, verification, claude-code-guide, statusline-setup — not all ported)')
    return chr(10).join(_lines)

# --- /mcp: mcp (显示已配置 MCP server) ---
def _mcp():
    import json as _j
    try:
        _mc = _j.loads(_mcp_load_config())
    except Exception:
        _mc = {}
    if not _mc:
        return 'MCP: no servers configured (.mcp.json mcpServers empty/missing). Add servers to .mcp.json.'
    _lines = ['MCP servers (%d):' % len(_mc)]
    for _n, _cfg in _mc.items():
        _cmd = _cfg.get('command', '?') if isinstance(_cfg, dict) else '?'
        _lines.append('  %s — command: %s' % (_n, _cmd))
    _lines.append('Use MCPTool / ListMcpResources / ReadMcpResource to interact.')
    return chr(10).join(_lines)

# --- /copy: copy last assistant reply to clipboard ---
def _copy():
    import subprocess as _sp, sys as _sys
    _a = _agent()
    if not _a:
        return 'No agent.'
    _reply = ''
    for _m in reversed(_a.messages):
        if _m.get('role') == 'assistant':
            _reply = str(_m.get('content', ''))
            break
    if not _reply:
        return 'No assistant reply to copy.'
    try:
        if _sys.platform == 'win32':
            _sp.run(['clip'], input=_reply, text=True, encoding='utf-8', errors='replace')
        elif _sys.platform == 'darwin':
            _sp.run(['pbcopy'], input=_reply, text=True)
        else:
            _sp.run(['xclip', '-selection', 'clipboard'], input=_reply, text=True)
        return 'Copied %d chars to clipboard.' % len(_reply)
    except Exception as _e:
        return 'Copy failed: %s' % _e

# --- /usage: detailed token stats ---
def _usage():
    _a = _agent()
    _msgs = _a.messages if _a else []
    _u = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'user')
    _as = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'assistant')
    _s = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'system')
    _total = _u + _as + _s
    _lines = ['Usage:',
              '  Messages: %d (system=%d, user=%d, assistant=%d)' % (len(_msgs), 1 if _s else 0, sum(1 for m in _msgs if m.get('role')=='user'), sum(1 for m in _msgs if m.get('role')=='assistant')),
              '  Est. tokens: %d (system=%d, user=%d, assistant=%d)' % (_total//4, _s//4, _u//4, _as//4),
              '  Context window: ~%d%% of 200K' % min(100, (_total//4*100)//200000)]
    return chr(10).join(_lines)

# --- /export: export conversation to markdown ---
def _export():
    import os as _os, time as _t
    _a = _agent()
    if not _a:
        return 'No agent.'
    _lines = ['# Claude Code Conversation Export', '']
    for _m in _a.messages:
        _role = _m.get('role', '?')
        _content = str(_m.get('content', ''))
        if _role == 'system':
            continue
        _lines.append('## %s' % ('User' if _role == 'user' else 'Assistant'))
        _lines.append('')
        _lines.append(_content)
        _lines.append('')
    _fname = 'conversation-%d.md' % int(_t.time())
    with open(_fname, 'w', encoding='utf-8') as _f:
        _f.write(chr(10).join(_lines))
    return 'Exported %d messages to %s' % (len(_a.messages), _fname)

# --- /undo: restore last file snapshot ---
def _undo():
    _hist = globals().get('_CCPORT_FILE_HISTORY', {})
    if not _hist:
        return 'Nothing to undo (no file history snapshots).'
    import os as _os, shutil as _shu
    for _fp in reversed(list(_hist.keys())):
        _stack = _hist[_fp]
        if _stack:
            _bak = _stack.pop()
            if _os.path.isfile(_bak):
                _shu.copy2(_bak, _fp)
                return 'Undo: restored %s from snapshot.' % _fp
    return 'No snapshots to restore.'

# --- /review: git diff code review ---
def _review():
    import subprocess as _sp
    try:
        _diff = _sp.run(['git', 'diff'], capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=15)
        _diff_text = (_diff.stdout or '').strip()
    except Exception:
        _diff_text = ''
    if not _diff_text:
        _diff = _sp.run(['git', 'diff', '--cached'], capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=15)
        _diff_text = (_diff.stdout or '').strip()
    if not _diff_text:
        return 'No changes to review (git diff is empty).'
    return 'Git diff (%d chars). Use the Agent tool to review:\n%s' % (len(_diff_text), _diff_text[:2000])

# --- /share: share conversation ---
def _share():
    import os as _os, time as _t
    _a = _agent()
    if not _a:
        return 'No agent.'
    _lines = ['# Claude Code Conversation', '']
    for _m in _a.messages:
        _role = _m.get('role', '?')
        if _role == 'system':
            continue
        _lines.append('## %s' % ('User' if _role == 'user' else 'Assistant'))
        _lines.append('')
        _lines.append(str(_m.get('content', '')))
        _lines.append('')
    _fname = 'shared-session-%d.md' % int(_t.time())
    with open(_fname, 'w', encoding='utf-8') as _f:
        _f.write(chr(10).join(_lines))
    return 'Shared session saved to %s (%d messages)' % (_fname, len(_a.messages))

# --- /git command family ---
def _git():
    import subprocess as _sp
    _sub = (_args or '').strip().split()
    _cmd = _sub[0] if _sub else 'status'
    _rest = _sub[1:] if len(_sub) > 1 else []
    _git_map = {
        'status': ['status', '--short'],
        'log': ['log', '--oneline', '--graph', '-n', '15'],
        'branch': ['branch', '-a'],
        'blame': ['blame'] + _rest,
        'stash': ['stash', 'list'] if not _rest else (['stash'] + _rest),
        'diff': ['diff'],
        'show': ['show'] + _rest,
        'cherry-pick': ['cherry-pick'] + _rest,
        'merge': ['merge'] + _rest,
        'push': ['push'] + _rest,
        'pull': ['pull'] + _rest,
        'commit': ['commit'] + _rest,
    }
    _args_list = _git_map.get(_cmd, ['status', '--short'])
    try:
        _p = _sp.run(['git'] + _args_list, capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=15)
        _out = (_p.stdout or '').strip()
        if not _out:
            _out = '(%s: no output, exit %d)' % (_cmd, _p.returncode)
        return _out
    except Exception as _e:
        return 'git %s failed: %s' % (_cmd, _e)

# --- /mcp add/remove/list enhancement ---
def _mcp_manage():
    import json as _j, os as _os
    _sub = (_args or '').strip().split(None, 2)
    _cfg_path = _os.path.join(_os.getcwd(), '.mcp.json')
    _cfg = {}
    if _os.path.isfile(_cfg_path):
        try:
            with open(_cfg_path, 'r') as _f:
                _cfg = _j.load(_f) or {}
        except Exception:
            pass
    _servers = _cfg.get('mcpServers', {})
    if not _sub or _sub[0] == 'list':
        if not _servers:
            return 'MCP: no servers configured.'
        _lines = ['MCP servers (%d):' % len(_servers)]
        for _n, _c in _servers.items():
            _lines.append('  %s — %s' % (_n, _c.get('command', '?') if isinstance(_c, dict) else '?'))
        return chr(10).join(_lines)
    if _sub[0] == 'add' and len(_sub) >= 3:
        _name, _cmd_str = _sub[1], _sub[2]
        _parts = _cmd_str.split()
        _servers[_name] = {'command': _parts[0], 'args': _parts[1:] if len(_parts) > 1 else []}
        _cfg['mcpServers'] = _servers
        with open(_cfg_path, 'w') as _f:
            _j.dump(_cfg, _f, indent=2)
        return 'Added MCP server: %s (%s)' % (_name, _cmd_str)
    if _sub[0] == 'remove' and len(_sub) >= 2:
        _name = _sub[1]
        if _name in _servers:
            del _servers[_name]
            _cfg['mcpServers'] = _servers
            with open(_cfg_path, 'w') as _f:
                _j.dump(_cfg, _f, indent=2)
            return 'Removed MCP server: %s' % _name
        return 'Server not found: %s' % _name
    return 'Usage: /mcp [list|add <name> <command>|remove <name>]'

# --- /pr: create PR (git push + gh pr create) ---
def _pr():
    import subprocess as _sp
    _title = _args or 'Auto PR from Nexa Claude Code'
    try:
        _p1 = _sp.run(['git', 'push'], capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=30)
        if _p1.returncode != 0:
            return 'git push failed: %s' % (_p1.stderr or _p1.stdout)[:200]
        _p2 = _sp.run(['gh', 'pr', 'create', '--title', _title, '--body', 'Created from Nexa Claude Code'],
                      capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=30)
        if _p2.returncode == 0:
            return 'PR created: %s' % (_p2.stdout or '').strip()
        return 'gh pr create failed (is gh installed?): %s' % (_p2.stderr or '')[:200]
    except Exception as _e:
        return '/pr failed: %s' % _e

