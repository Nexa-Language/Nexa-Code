// =============================================================================
// commands.nx — 斜杠命令忠实移植（Phase 3）
// -----------------------------------------------------------------------------
// 每个命令 handler 忠实移植自 refs/claude-code-ts/src/commands/<name>/ 的核心行为。
// UI 渲染（Ink/React 弹窗、picker、对话框）是平台层细节，本移植对齐【命令行为】，
// 文本输出经 std.ui/print。命令经 main.nx flow 的 run_command 派发接入（对齐
// REPL.tsx:3967-4036 onSubmit 的「/ 开头→命令派发」）。
// 翻译源（逐命令）：
//   /help    ← commands/help/index.ts + help.tsx（HelpV2 列出命令）
//   /clear   ← commands/clear/clear.ts + conversation.ts:70-281（clearConversation：reset messages/readFileState/cost）
//   /compact ← commands/compact/compact.ts（compactConversation：摘要替换旧消息）
//   /model   ← commands/model/model.tsx（显示/切换模型）
//   /cost    ← commands/cost→usage（token/成本统计）
//   /status  ← commands/status/status.tsx（Settings>Status：cwd/model/git/config）
//   /exit    ← commands/exit/exit.tsx（gracefulShutdown）
//   /resume  ← commands/resume（列出/恢复会话）
//   /rewind  ← commands/rewind/rewind.ts（回退到某条消息）
//   /vim     ← commands/vim/vim.ts（切换 editorMode normal↔vim）
//   /fast    ← commands/fast/fast.tsx（切换 fastMode；Opus 专属）
//   /config  ← commands/config/config.tsx（显示/编辑 settings）
//   /context ← commands/context（显示 CLAUDE.md/git/env 上下文，复用 context.nx）
// 忠实度：见各 handler 备注（行为对齐；UI/会话存储/模型菜单等平台层项标 partial）。
// python! 用单 \n（真换行）；复合布尔在 python! 内；exit 经 "__CC_EXIT__" 哨兵返回。
// =============================================================================

// 派发斜杠命令。返回命令输出文本；/exit 返回 "__CC_EXIT__" 哨兵（flow 据此退出）。
@tool("Dispatch a slash command (Phase 3 + Phase 7). Returns output text; /exit returns __CC_EXIT__ sentinel; /init returns __AS_PROMPT__:... (flow routes to engine).")
fn run_command(cmd_line: string): string {
    python! """
import os

# P0 深化: 确保 session 计时/成本状态在所有模式可用（生产路径 run_json_events 启动时已设更早 t0）
globals().setdefault('_CCPORT_SESSION_T0', __import__('time').time())
globals().setdefault('_CCPORT_COST_STATE', {})

# --- 解析 命令名 + 参数 (REPL.tsx:4011-4018) ---
_line = (cmd_line or '').strip()
if _line.startswith('/'):
    _line = _line[1:]
_sp = _line.find(' ')
if _sp == -1:
    _name, _args = _line, ''
else:
    _name, _args = _line[:_sp], _line[_sp:].strip()

def _agent():
    return globals().get('Coder')

# P3 深化公共 helper: 持久化单个设置到 settings.local.json（对齐 CC updateSettingsForSource）
def _persist_setting(_key, _val):
    import json as _j
    _target = os.path.join(os.getcwd(), '.claude', 'settings.local.json')
    _data = {}
    if os.path.dirname(_target):
        os.makedirs(os.path.dirname(_target), exist_ok=True)
    if os.path.isfile(_target):
        try:
            with open(_target, 'r', encoding='utf-8') as _f:
                _data = _j.load(_f) or {}
        except Exception:
            _data = {}
    if _val is None:
        _data.pop(_key, None)
    else:
        _data[_key] = _val
    with open(_target, 'w', encoding='utf-8') as _f:
        _j.dump(_data, _f, ensure_ascii=False, indent=2)

# --- /help: commands/help (HelpV2 列出命令) ---
def _help():
    _cmds = [
        ('/help', 'Show help and available commands'),
        ('/clear', 'Clear conversation history and free up context'),
        ('/compact [instructions]', 'Clear conversation history but keep a summary'),
        ('/model', 'Show / switch the current model'),
        ('/cost', 'Show token usage and cost'),
        ('/status', 'Show account/session status (cwd, model, git)'),
        ('/context', 'Show the assembled context (CLAUDE.md, git, env)'),
        ('/config', 'Show config / settings'),
        ('/vim', 'Toggle editor mode (normal <-> vim)'),
        ('/fast', 'Toggle fast mode (Opus-specific; note under GLM)'),
        ('/rewind', 'Rewind to a previous message'),
        ('/resume', 'Resume a previous session'),
        ('/init', 'Analyze repo and create CLAUDE.md (agent-driven)'),
        ('/doctor', 'Diagnose installation and settings'),
        ('/add-dir <path>', 'Add a working directory'),
        ('/memory', 'Show CLAUDE.md memory file hierarchy'),
        ('/permissions', 'Show allow/deny permission rules and mode'),
        ('/agents', 'List configured agents'),
        ('/mcp', 'Show configured MCP servers'),
        ('/copy', 'Copy last assistant reply to clipboard'),
        ('/usage', 'Detailed token/cost statistics'),
        ('/export', 'Export conversation to markdown file'),
        ('/undo', 'Undo last file edit (restore snapshot)'),
        ('/review', 'Show git diff for code review'),
        ('/share', 'Share conversation as markdown file'),
        ('/git <sub>', 'Git: status|log|branch|blame|stash|diff|cherry-pick|merge|push|pull'),
        ('/pr', 'Create a PR (git push + gh pr create)'),
        ('/login', 'Show API key / provider configuration'),
        ('/feedback', 'Record user feedback'),
        ('/keybindings', 'Show keyboard shortcuts'),
        ('/release-notes', 'Show version history'),
        ('/screenshot', 'Capture terminal screenshot'),
        ('/terminal-setup', 'Terminal integration tips'),
        ('/bug', 'Report a bug'),
        ('/install <pkg>', 'Install a package (pip/bun)'),
        ('/plugin', 'Plugin management info'),
        ('/exit', 'Exit the REPL'),
    ]
    _lines = ['Available commands:']
    for _c, _d in _cmds:
        _lines.append('  %s - %s' % (_c, _d))
    return '\n'.join(_lines)

# --- /clear: clear/clear.ts + conversation.ts:70-281 (clearConversation 完整深化) ---
# CC clearConversation: SessionEnd hooks → setMessages([]) → clearSessionCaches →
#   setLastAPIRequest(null) → resetCostState() → readFileState.clear() → fileHistory cleared →
#   clearAllPlanSlugs → clearSessionMetadata → regenerateSessionId → resetSessionFilePointer →
#   processSessionStartHooks. 本深化对齐核心可移植项；session/task/MCP 重置是平台子系统。
def _clear():
    _a = _agent()
    if _a is None:
        return 'No agent.'
    # CC conversation.ts:89 executeSessionEndHooks('clear') — SessionEnd 钩子（best-effort）
    try:
        run_hook_event('SessionEnd', '', '{}')
    except Exception:
        pass
    _a.messages = [{'role': 'system', 'content': _a.system_prompt}]
    # CC conversation.ts:160 readFileState.clear()
    globals().get('_CCPORT_READ_STATE', {}).clear()
    # CC conversation.ts:205 fileHistory snapshots cleared
    globals().setdefault('_CCPORT_FILE_HISTORY', {}).clear()
    # CC conversation.ts:157 resetCostState — 清成本累积器（原位重置 + 清每模型状态）
    globals().pop('_CCPORT_COST_STATE', None)
    _ua = globals().get('_usage_acc')
    if isinstance(_ua, dict):
        for _k in list(_ua.keys()):
            _ua[_k] = 0
    # CC conversation.ts:233 regenerateSessionId — 新 session 标记 + 重置计时
    import time as _t, hashlib as _hl
    globals()['_CCPORT_SESSION_ID'] = _hl.md5((os.getcwd() + str(_t.time())).encode()).hexdigest()[:12]
    globals()['_CCPORT_SESSION_T0'] = _t.time()
    # CC conversation.ts:275 processSessionStartHooks('clear') — SessionStart 钩子（best-effort）
    try:
        run_hook_event('SessionStart', '', '{}')
    except Exception:
        pass
    return 'Conversation cleared. Context freed. (messages, file history, cost state, session id reset)'

# --- /compact: compact/compact.ts (compactConversation: 深化版，对齐 CC 算法) ---
# CC: compactConversation(complex.ts:411-660) + getCompactPrompt(prompt.ts:293) +
#     formatCompactSummary(prompt.ts:311) + getCompactUserSummaryMessage(prompt.ts:337) +
#     buildPostCompactMessages(compact.ts:336) + messagesToKeep 保留近 N 条
def _compact():
    _a = _agent()
    if _a is None:
        return 'No agent.'
    _msgs = [m for m in _a.messages if m.get('role') in ('user', 'assistant')]
    if len(_msgs) < 4:
        return 'No messages to compact'
    import re as _re
    # CC compact.ts: 分组保留近 4 条消息（对齐 groupMessagesByApiRound 的 keep-recent）
    _keep = _msgs[-4:]
    _sum_msgs = _msgs[:-4]
    if len(_sum_msgs) < 2:
        return 'Too few messages to compact (need >4 after keeping recent 4).'
    _transcript = chr(10).join('[%s] %s' % (m.get('role'), str(m.get('content'))[:600]) for m in _sum_msgs)
    # CC prompt.ts getCompactPrompt: BASE_COMPACT_PROMPT 9-section + custom instructions
    _compact_prompt = (
        'Your task is to create a detailed summary of the conversation so far, '
        'paying close attention to the user explicit requests and your previous actions. '
        'This summary should be thorough in capturing technical details, code patterns, '
        'and architectural decisions that would be essential for continuing development work without losing context.'
        + chr(10) + chr(10) +
        'Your summary should include the following sections:' + chr(10) + chr(10) +
        '1. Primary Request and Intent' + chr(10) +
        '2. Key Technical Concepts' + chr(10) +
        '3. Files and Code Sections' + chr(10) +
        '4. Errors and fixes' + chr(10) +
        '5. Problem Solving' + chr(10) +
        '6. All user messages' + chr(10) +
        '7. Pending Tasks' + chr(10) +
        '8. Current Work' + chr(10) +
        '9. Optional Next Step'
    )
    if _args and _args.strip():
        _compact_prompt = _compact_prompt + chr(10) + chr(10) + 'Additional Instructions:' + chr(10) + _args
    try:
        _client = _a._get_client()
        _resp = _client.chat.completions.create(
            model=_a.model, timeout=90,
            messages=[{'role': 'system', 'content': _compact_prompt},
                      {'role': 'user', 'content': _transcript}])
        _raw = _resp.choices[0].message.content or '(empty summary)'
        # CC formatCompactSummary: strip <analysis>, extract <summary> content
        _summary = _re.sub(r'<analysis>.*?</analysis>', '', _raw, flags=_re.DOTALL).strip()
        _m = _re.search(r'<summary>(.*?)</summary>', _summary, _re.DOTALL)
        if _m:
            _summary = 'Summary:' + chr(10) + _m.group(1).strip()
        _summary = _re.sub(r'\n\n+', chr(10) + chr(10), _summary).strip()
        # CC getCompactUserSummaryMessage: framing + transcript path + "recent preserved"
        _framed = ('This session is being continued from a previous conversation that ran out of context. '
                   'The summary below covers the earlier portion of the conversation.' + chr(10) + chr(10) + _summary
                   + chr(10) + chr(10) + 'Recent messages are preserved verbatim.')
        # CC buildPostCompactMessages: system + summary_user + ack + recent_kept
        _sys = [m for m in _a.messages if m.get('role') == 'system']
        _a.messages = _sys + [
            {'role': 'user', 'content': _framed},
            {'role': 'assistant', 'content': 'Understood. I have the summary and the recent messages are preserved.'}
        ] + _keep
        return 'Compacted: %d messages -> CC 9-section summary + kept last 4.' % len(_msgs)
    except Exception as _e:
        return 'Compact failed: %s' % _e

# --- /model: model/model.tsx (深化版 — 对齐 CC: 运行时切换 + 持久化到 settings) ---
# CC: commands/model/model.tsx → ModelPicker (interactive) + config persistence via updateSettingsForSource
# 深化：切换时持久化到 secrets.nxs MODEL_NAME.default + 列出可用模型（从 secrets.nxs）
def _model():
    _a = _agent()
    if not _a:
        return '(no agent)'
    if _args:
        _new = _args.strip().split()[0]
        _a.model = _new
        for _attr in ('_client', '_client_cache', '__client_cache__'):
            if hasattr(_a, _attr):
                try:
                    setattr(_a, _attr, None)
                except Exception:
                    pass
        # CC model.tsx persists to settings; we persist to secrets.nxs MODEL_NAME
        try:
            import os as _os, re as _re
            _sf = _os.path.join(_os.getcwd(), 'secrets.nxs')
            if _os.path.isfile(_sf):
                with open(_sf, 'r', encoding='utf-8') as _f:
                    _content = _f.read()
                _content = _re.sub(r'"default":\s*"[^"]*"', '"default": "%s"' % _new, _content)
                _content = _re.sub(r'"strong":\s*"[^"]*"', '"strong": "%s"' % _new, _content)
                _content = _re.sub(r'"weak":\s*"[^"]*"', '"weak": "%s"' % _new, _content)
                with open(_sf, 'w', encoding='utf-8') as _f:
                    _f.write(_content)
        except Exception:
            pass
        return 'Model switched to: %s (next turn uses it; persisted to secrets.nxs).' % _new
    # 列出可用模型（从 secrets.nxs MODEL_NAME）
    import os as _os, re as _re
    _models = []
    _sf = _os.path.join(_os.getcwd(), 'secrets.nxs')
    if _os.path.isfile(_sf):
        try:
            with open(_sf, 'r', encoding='utf-8') as _f:
                _c = _f.read()
            for _m in _re.findall(r'"(glm-[\w.]+)"', _c):
                if _m not in _models:
                    _models.append(_m)
        except Exception:
            pass
    _avail = ''
    if _models:
        _avail = chr(10) + 'Available: ' + ', '.join(_models)
    return 'Current model: %s%s%s' % (_a.model, _avail, chr(10) + 'Usage: /model <name> to switch (e.g. /model glm-5.1; must have quota).')

# --- /cost: cost.ts → formatTotalCost (cost-tracker.ts:229) 深化 ---
# CC /cost 对订阅者显示订阅消息，否则 formatTotalCost()（总额 + 每模型 input/output/cache + 时长 + 行变更）。
# 本深化：读真实 API usage（_CCPORT_USAGE/_CCPORT_COST_STATE，main.nx monkey-patch 累积），
#   格式对齐 formatTotalCost（总额 + 每模型分项 + context window% + 模型名）。GLM 无 Claude 计价 → 标注。
def _cost():
    _a = _agent()
    _ua = globals().get('_usage_acc') or globals().get('_CCPORT_USAGE') or {}
    _cs = globals().get('_CCPORT_COST_STATE', {})
    _model = _a.model if _a else '?'
    _tot_in = _ua.get('input', 0) if isinstance(_ua, dict) else 0
    _tot_out = _ua.get('output', 0) if isinstance(_ua, dict) else 0
    _lines = ['Total cost:            (GLM runtime: not billed via Claude pricing — showing real token usage)']
    if _tot_in or _tot_out:
        _lines.append('Total usage:           %d input, %d output tokens (%d total)' % (_tot_in, _tot_out, _tot_in + _tot_out))
    else:
        _est = sum(len(str(m.get('content', ''))) for m in (_a.messages if _a else [])) // 4
        _lines.append('Total usage:           ~%d tokens (estimated; no API usage recorded yet)' % _est)
    # CC formatModelUsage: 每模型分项
    if _cs:
        for _m in sorted(_cs.keys()):
            _u = _cs[_m]
            _calls = _u.get('calls', 0)
            _lines.append('%s:%s %d input, %d output (%d API call%s)' % (
                _m, ' ' * max(1, 21 - len(_m) - 1), _u.get('input', 0), _u.get('output', 0), _calls, '' if _calls == 1 else 's'))
    # context window% (CC ModelUsage.contextWindow)
    _ctx = (_tot_in + _tot_out) or (sum(len(str(m.get('content', ''))) for m in (_a.messages if _a else [])) // 4)
    _lines.append('Context window:        ~%d%% of 128K (model=%s)' % (min(100, (_ctx * 100) // 128000), _model))
    return chr(10).join(_lines)

# --- /status: status.tsx → Settings>Status tab 深化 ---
# CC /status 是 Settings UI 组件（defaultTab="Status"）；行为=展示状态信息。本深化：补 mode/tool count/
#   elapsed/auto-compact（对齐 Settings Status 面板字段）。UI 是平台层，文本对齐为诚实适配。
def _status():
    import subprocess, time as _t
    _a = _agent()
    _cwd = os.getcwd()
    _branch = ''
    try:
        _b = subprocess.run(['git', 'branch', '--show-current'], capture_output=True, text=True, timeout=5)
        _branch = (_b.stdout or '').strip()
    except Exception:
        pass
    _mode = globals().get('_CCPORT_MODE', 'default')
    _lt = globals().get('LOCAL_TOOLS', {})
    _ntools = len(_lt) if isinstance(_lt, dict) else 0
    _t0 = globals().get('_CCPORT_SESSION_T0')
    _elapsed = ('%ds' % int(_t.time() - _t0)) if _t0 else '?'
    _msgs = _a.messages if _a else []
    _est = sum(len(str(m.get('content', ''))) for m in _msgs) // 4
    _lines = ['Status:',
              '  Working directory: %s' % _cwd,
              '  Model: %s' % (_a.model if _a else '(none)'),
              '  Git branch: %s' % (_branch or '(not a git repo)'),
              '  Permission mode: %s' % _mode,
              '  Tools available: %d' % _ntools,
              '  Messages in context: %d' % len(_msgs),
              '  Session elapsed: %s' % _elapsed,
              '  Auto-compact: ~%d%% of 128K' % min(100, (_est * 100) // 128000)]
    return '\n'.join(_lines)

# --- /context: context (显示 CLAUDE.md/git/env，复用 context.nx) ---
def _context():
    try:
        return build_user_context(_agent().model if _agent() else 'glm-4-flash')
    except Exception as _e:
        return 'Context error: %s' % _e

# --- /config: config/config.tsx (显示 settings) ---
# --- /config: config (深化版 — 对齐 CC getInitialSettings + updateSettingsForSource) ---
# CC: commands/config/config.tsx → Settings/Config.tsx (interactive picker)
# + utils/settings/settings.ts:309 getSettingsForSource / :416 updateSettingsForSource / :812 getInitialSettings
# 深化：get/set/list/edit 子命令，多源合并读取（user→project→local），持久化写入 settings.local.json
def _config():
    import json as _j
    _home = os.path.expanduser('~')
    _sources = [
        ('user', os.path.join(_home, '.claude', 'settings.json')),
        ('project', os.path.join(os.getcwd(), '.claude', 'settings.json')),
        ('local', os.path.join(os.getcwd(), '.claude', 'settings.local.json')),
    ]
    _parts = (_args or '').strip().split(None, 2)
    if not _parts or _parts[0] == 'list':
        _merged = {}
        _lines = ['Config (merged from all sources):']
        for _src_name, _src_path in _sources:
            if os.path.isfile(_src_path):
                try:
                    with open(_src_path, 'r', encoding='utf-8') as _f:
                        _data = _j.load(_f) or {}
                    _merged.update(_data)
                    _lines.append('  [%s] %s (%d keys)' % (_src_name, _src_path, len(_data)))
                except Exception:
                    pass
        if _merged:
            _lines.append('')
            _lines.append('Effective settings:')
            for _k in sorted(_merged.keys()):
                _lines.append('  %s: %s' % (_k, _j.dumps(_merged[_k], ensure_ascii=False)[:100]))
        else:
            _lines.append('  (no settings files found; using built-in defaults)')
        _lines.append('')
        _lines.append('Usage: /config [get|set|list] [key] [value]')
        return chr(10).join(_lines)
    _action = _parts[0].lower()
    if _action == 'get' and len(_parts) >= 2:
        _key = _parts[1]
        for _src_name, _src_path in _sources:
            if os.path.isfile(_src_path):
                try:
                    with open(_src_path, 'r', encoding='utf-8') as _f:
                        _data = _j.load(_f) or {}
                    if _key in _data:
                        return '%s = %s (from %s)' % (_key, _j.dumps(_data[_key], ensure_ascii=False), _src_name)
                except Exception:
                    pass
        return '%s = (not set)' % _key
    if _action == 'set' and len(_parts) >= 3:
        _key = _parts[1]
        _val = _parts[2]
        _target = os.path.join(os.getcwd(), '.claude', 'settings.local.json')
        _data = {}
        os.makedirs(os.path.dirname(_target), exist_ok=True) if os.path.dirname(_target) else None
        if os.path.isfile(_target):
            try:
                with open(_target, 'r', encoding='utf-8') as _f:
                    _data = _j.load(_f) or {}
            except Exception:
                _data = {}
        try:
            _parsed = _j.loads(_val)
        except Exception:
            _parsed = _val
        _data[_key] = _parsed
        with open(_target, 'w', encoding='utf-8') as _f:
            _j.dump(_data, _f, ensure_ascii=False, indent=2)
        return 'Set %s = %s (saved to %s)' % (_key, _j.dumps(_parsed, ensure_ascii=False), _target)
    return 'Usage: /config [list|get <key>|set <key> <value>]'

# --- /vim: vim/vim.ts (切换 editorMode normal<->vim) ---
def _vim():
    _cfg = globals().setdefault('_CCPORT_GLOBAL_CONFIG', {})
    _cur = _cfg.get('editorMode', 'normal')
    if _cur == 'emacs':
        _cur = 'normal'
    _new = 'vim' if _cur == 'normal' else 'normal'
    _cfg['editorMode'] = _new
    if _new == 'vim':
        return 'Editor mode set to vim. Use Escape key to toggle between INSERT and NORMAL modes.'
    return 'Editor mode set to normal. Using standard (readline) keyboard bindings.'

# --- /fast: fast/fast.tsx 深化（persist to userSettings + on|off + GLM 无 fast model 标注）---
# CC fast.tsx: applyFastMode → updateSettingsForSource('userSettings', {fastMode}); /fast on|off 直接切换；
#   fast model 切换（Opus 专属）。GLM 无 fast model → 标注无模型效果，仅持久化标志位。
def _fast():
    _cfg = globals().setdefault('_CCPORT_GLOBAL_CONFIG', {})
    _arg = (_args or '').strip().lower()
    if _arg == 'on':
        _cfg['fastMode'] = True
    elif _arg == 'off':
        _cfg['fastMode'] = False
    else:
        _cfg['fastMode'] = not bool(_cfg.get('fastMode', False))
    _enabled = bool(_cfg['fastMode'])
    # CC applyFastMode: persist fastMode=true | undefined
    _persist_setting('fastMode', True if _enabled else None)
    _state = 'ON' if _enabled else 'OFF'
    _note = ('Fast mode uses the same frontier model with faster output (Opus-specific, premium billing). '
             'Under the GLM runtime, fast mode has no model effect; flag persisted for parity.')
    return 'Fast mode %s. %s' % (_state, _note)

# --- /rewind: rewind (深化版 — 对齐 CC rewind: 消息列表 + 内容搜索 + 数值回退) ---
# CC: commands/rewind/rewind.ts → openMessageSelector (UI picker)
# CC rewind command itself is thin — actual logic is in UI (LogSelector).
# 深化：list 显示消息索引、search 按内容查找、数字回退保留。
def _rewind():
    _a = _agent()
    if _a is None:
        return 'No agent.'
    _arg = (_args or '').strip()
    _msgs = _a.messages
    _rest = [_m for _m in _msgs if _m.get('role') != 'system']

    if _arg == 'list' or _arg == '':
        if not _rest:
            return 'No messages to rewind.'
        _lines = ['Messages (%d, oldest first):' % len(_rest)]
        for _i, _m in enumerate(_rest):
            _role = _m.get('role', '?')
            _text = str(_m.get('content', ''))[:60].replace(chr(10), ' ')
            _lines.append('  [%d] %s: %s' % (_i + 1, _role, _text))
        _lines.append(chr(10) + 'Usage: /rewind <n> to drop last n turns, or /rewind search <query>')
        return chr(10).join(_lines)

    if _arg.startswith('search '):
        _q = _arg[7:].lower()
        _matches = []
        for _i, _m in enumerate(_rest):
            if _q in str(_m.get('content', '')).lower():
                _matches.append('  [%d] %s: %s' % (_i + 1, _m.get('role', '?'), str(_m.get('content', ''))[:60].replace(chr(10), ' ')))
        if not _matches:
            return 'No messages matching "%s".' % _q
        return 'Matches (%d):' % len(_matches) + chr(10) + chr(10).join(_matches)

    if _arg.lstrip('-').isdigit():
        _n = int(_arg)
        _kept = [_m for _m in _msgs if _m.get('role') == 'system']
        if _n >= len(_rest):
            _a.messages = _kept
            return 'Rewound: cleared all non-system messages.'
        _drop = _n * 2
        if _drop > len(_rest):
            _drop = len(_rest)
        _a.messages = _kept + _rest[:len(_rest) - _drop]
        return 'Rewound %d turn(s), %d messages remaining.' % (_n, len(_a.messages) - len(_kept))

    return 'Usage: /rewind [list|search <query>|<n>]'

# --- /resume: resume (深化版 — 对齐 CC resume.tsx: session 列表 + 选择 + 恢复) ---
# CC: commands/resume/resume.tsx → LogSelector (interactive picker)
# + utils/sessionStorage.ts: listSessions + loadFullLog + readTranscriptForLoad
# 深化：列出 sessions + 按 ID/路径恢复（调用 harness.nx load_session）
def _resume():
    _arg = (_args or '').strip()
    if not _arg or _arg == 'list':
        _listing = list_sessions()
        if 'No saved' in _listing or not _listing.strip():
            return 'No previous sessions found.\nUse /clear for a fresh session or save one with the session being compacted/ended.'
        return 'Available sessions:\n' + _listing
    # CC resume with arg: load specific session by path or ID
    try:
        _result = load_session(_arg)
        return _result
    except Exception as _e:
        return 'Resume failed: %s\nRun /resume to list available sessions.' % _e

# --- /exit: exit/exit.tsx (gracefulShutdown) ---
def _exit():
    return '__CC_EXIT__'

# --- /init: init.ts (NEW_INIT_PROMPT, local-prompt → agent 调研+写 CLAUDE.md) ---
def _init():
    _p = (
        "Set up a minimal CLAUDE.md for this repo. CLAUDE.md loads into every session, so keep it concise — only what Claude would get wrong without it. "
        "Steps: (1) survey the codebase — read manifest files (package.json / pyproject.toml / Cargo.toml / go.mod / etc.), README, Makefile / build configs, CI config, existing CLAUDE.md. "
        "(2) write a concise CLAUDE.md with non-obvious commands, gotchas, branch/PR conventions, required env setup, testing quirks. "
        "Do NOT include obvious instructions (error messages / unit tests / no secrets). Use the Write tool to create CLAUDE.md."
    )
    return '__AS_PROMPT__:' + _p

# --- /doctor: doctor (诊断安装/设置) ---
def _doctor():
    import json as _j, os as _os, sys as _sys
    _a = globals().get('Coder')
    try:
        _mc = _j.loads(_mcp_load_config())
    except Exception:
        _mc = {}
    _st = globals().get('_CCPORT_RULES', {})
    _lines = ['Doctor:']
    _lines.append('  model: %s' % (_a.model if _a else '(none)'))
    _lines.append('  cwd: %s' % _os.getcwd())
    _lines.append('  secrets.nxs: %s' % ('found' if _os.path.isfile('secrets.nxs') else 'MISSING'))
    _lines.append('  .claude/settings.local.json: %s' % ('found' if _os.path.isfile('.claude/settings.local.json') else 'none'))
    _lines.append('  MCP servers configured: %d %s' % (len(_mc), list(_mc.keys())))
    _lines.append('  permission rules: allow=%d deny=%d ask=%d' % (len(_st.get('allow', [])), len(_st.get('deny', [])), len(_st.get('ask', []))))
    _lines.append('  permission mode: %s' % globals().get('_CCPORT_MODE', 'default'))
    _lines.append('  python: %s' % _sys.version.split()[0])
    _lines.append('  agent messages: %d' % (len(_a.messages) if _a else 0))
    return chr(10).join(_lines)

# --- /add-dir <path>: add-dir (添加工作目录) ---
def _add_dir():
    if not _args:
        return 'Usage: /add-dir <path>'
    import os as _os
    _ap = _os.path.abspath(_args.split()[0])
    _d = globals().setdefault('_CCPORT_ADD_DIRS', [])
    if _ap not in _d:
        _d.append(_ap)
    return 'Added working directory: %s (total: %d)' % (_ap, len(_d))

# --- /memory: memory (列出 CLAUDE.md 层级 memory 文件) ---
def _memory():
    import os as _os
    _home = _os.path.expanduser('~')
    _files = [
        (_os.path.join(_home, '.claude', 'CLAUDE.md'), 'user (global)'),
        (_os.path.join(_os.getcwd(), 'CLAUDE.md'), 'project'),
        (_os.path.join(_os.getcwd(), '.claude', 'CLAUDE.md'), 'project (.claude/)'),
    ]
    _lines = ['Memory files (CLAUDE.md hierarchy):']
    for _p, _tag in _files:
        _ex = 'exists' if _os.path.isfile(_p) else 'missing'
        _lines.append('  [%s] %s — %s' % (_tag, _p, _ex))
    _lines.append('Edit with your $EDITOR or the Edit tool.')
    return chr(10).join(_lines)

# --- /permissions: permissions (深化版 — 对齐 CC PermissionRuleList: add/remove/list + 持久化) ---
# CC: commands/permissions/permissions.tsx → PermissionRuleList (interactive)
# + utils/permissions/permissionsLoader.ts addPermissionRulesToSource (persist to settings)
# + utils/permissions/permissionSetup.ts (mode switching)
def _permissions():
    _st = globals().get('_CCPORT_RULES', {'allow': [], 'deny': [], 'ask': []})
    _mode = globals().get('_CCPORT_MODE', 'default')
    _parts = (_args or '').strip().split(None, 2)
    if not _parts or _parts[0] == 'list':
        _lines = ['Permission rules (mode=%s):' % _mode,
                  '  allow (%d): %s' % (len(_st.get('allow', [])), _st.get('allow', [])),
                  '  deny  (%d): %s' % (len(_st.get('deny', [])), _st.get('deny', [])),
                  '  ask   (%d): %s' % (len(_st.get('ask', [])), _st.get('ask', [])),
                  'Usage: /permissions [add|remove] [allow|deny|ask] <rule>']
        return chr(10).join(_lines)
    _action = _parts[0].lower()
    if _action in ('add', 'remove') and len(_parts) >= 3:
        _behavior = _parts[1].lower()
        _rule = _parts[2]
        if _behavior not in ('allow', 'deny', 'ask'):
            return 'Invalid behavior: %s (use allow|deny|ask)' % _behavior
        if _action == 'add':
            if _rule not in _st.get(_behavior, []):
                _st.setdefault(_behavior, []).append(_rule)
                globals()['_CCPORT_RULES'] = _st
            return 'Added rule: %s %s' % (_behavior, _rule)
        if _action == 'remove':
            if _rule in _st.get(_behavior, []):
                _st[_behavior].remove(_rule)
                globals()['_CCPORT_RULES'] = _st
                return 'Removed rule: %s %s' % (_behavior, _rule)
            return 'Rule not found: %s %s' % (_behavior, _rule)
    return 'Usage: /permissions [list|add|remove] [allow|deny|ask] <rule>'

# --- /agents: agents (列出已配置 agent) ---
def _agents():
    _a = globals().get('Coder')
    _lines = ['Agents:']
    _lines.append('  Coder (main, model=%s, tools=14)' % (_a.model if _a else '?'))
    _lines.append('  Built-in subagent types (Agent tool):')
    _lines.append('    general-purpose — all tools, isolated context')
    _lines.append('    explore — read-only (Read/Glob/Grep)')
    _lines.append('  (CC also has: plan, verification, claude-code-guide, statusline-setup — not all ported)')
    return chr(10).join(_lines)

# --- /mcp: mcp (显示已配置 MCP server) ---
def _mcp():
    import json as _j
    try:
        _mc = _j.loads(_mcp_load_config())
    except Exception:
        _mc = {}
    if not _mc:
        return 'MCP: no servers configured (.mcp.json mcpServers empty/missing). Add servers to .mcp.json.'
    _lines = ['MCP servers (%d):' % len(_mc)]
    for _n, _cfg in _mc.items():
        _cmd = _cfg.get('command', '?') if isinstance(_cfg, dict) else '?'
        _lines.append('  %s — command: %s' % (_n, _cmd))
    _lines.append('Use MCPTool / ListMcpResources / ReadMcpResource to interact.')
    return chr(10).join(_lines)

# --- /copy: copy.tsx 深化（collectRecentAssistantTexts + /copy N + temp 文件双写）---
# CC copy.tsx:44 collectRecentAssistantTexts（最新优先，跳 tool-use-only/api-error 轮）
# CC copy.tsx:243 /copy N 回溯 N-1（1=最新）；copy.tsx:69-74 clipboard best-effort + temp 文件可靠 fallback
def _copy():
    import subprocess as _sp, sys as _sys, os as _os, tempfile as _tf
    _a = _agent()
    if not _a:
        return 'No agent.'
    # CC collectRecentAssistantTexts: 倒序收集有文本的 assistant 轮（跳空=tool-use-only），cap 20
    _texts = []
    for _m in reversed(_a.messages):
        if _m.get('role') != 'assistant':
            continue
        _c = str(_m.get('content', '')).strip()
        if _c:
            _texts.append(_c)
        if len(_texts) >= 20:
            break
    if not _texts:
        return 'No assistant message to copy.'
    # CC copy.tsx:243 /copy N: N>=1, age = N-1
    _arg = (_args or '').strip()
    _age = 0
    if _arg:
        try:
            _n = int(_arg)
        except ValueError:
            return 'Usage: /copy [N] where N is 1 (latest), 2, 3, ... Got: %s' % _arg
        if _n < 1 or _n > len(_texts):
            return 'Only %d assistant message(s) available to copy' % len(_texts)
        _age = _n - 1
    _text = _texts[_age]
    # CC copy.tsx:76 setClipboard best-effort（OSC 52 需终端支持）
    _clip_ok = True
    try:
        if _sys.platform == 'win32':
            _sp.run(['clip'], input=_text, text=True, encoding='utf-8', errors='replace')
        elif _sys.platform == 'darwin':
            _sp.run(['pbcopy'], input=_text, text=True)
        else:
            _sp.run(['xclip', '-selection', 'clipboard'], input=_text, text=True)
    except Exception:
        _clip_ok = False
    # CC copy.tsx:69-74 temp 文件 fallback（clipboard 可能不可靠）
    _nlines = _text.count(chr(10)) + 1
    _dir = _os.path.join(_tf.gettempdir(), 'claude')
    try:
        _os.makedirs(_dir, exist_ok=True)
        _fp = _os.path.join(_dir, 'response.md')
        with open(_fp, 'w', encoding='utf-8') as _f:
            _f.write(_text)
        if _clip_ok:
            return 'Copied to clipboard (%d characters, %d lines)\nAlso written to %s' % (len(_text), _nlines, _fp)
        return 'Clipboard unavailable; written to %s (%d characters, %d lines)' % (_fp, len(_text), _nlines)
    except Exception:
        return 'Copied %d chars to clipboard.' % len(_text) if _clip_ok else 'Copy failed (no clipboard, no temp write).'

# --- /usage: usage.tsx (Settings→Usage tab) 深化（unified /cost+/stats；读真实 usage）---
# CC /usage: 订阅者→Usage tab(plan limits)，API→Stats panel(session cost/token/activity)；/cost /stats 是别名。
# Nexa 适配：合并 token 统计 + 每模型分项 + context window%（读 _CCPORT_USAGE/_CCPORT_COST_STATE）。
def _usage():
    _a = _agent()
    _msgs = _a.messages if _a else []
    _ua = globals().get('_usage_acc') or globals().get('_CCPORT_USAGE') or {}
    _cs = globals().get('_CCPORT_COST_STATE', {})
    _model = _a.model if _a else '?'
    _nu = sum(1 for m in _msgs if m.get('role') == 'user')
    _na = sum(1 for m in _msgs if m.get('role') == 'assistant')
    _sys_c = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'system')
    _u_c = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'user')
    _a_c = sum(len(str(m.get('content', ''))) for m in _msgs if m.get('role') == 'assistant')
    _tot_in = _ua.get('input', 0) if isinstance(_ua, dict) else 0
    _tot_out = _ua.get('output', 0) if isinstance(_ua, dict) else 0
    _lines = ['Usage (session stats):',
              '  Messages: %d (user=%d, assistant=%d)' % (len(_msgs), _nu, _na),
              '  Real API tokens: %d input, %d output (%d total)' % (_tot_in, _tot_out, _tot_in + _tot_out),
              '  Context chars: %d (system=%d, user=%d, assistant=%d)' % (_sys_c + _u_c + _a_c, _sys_c, _u_c, _a_c)]
    if _cs:
        _lines.append('  Per-model:')
        for _m in sorted(_cs.keys()):
            _u = _cs[_m]
            _lines.append('    %s: %d in / %d out (%d calls)' % (_m, _u.get('input', 0), _u.get('output', 0), _u.get('calls', 0)))
    _ctx = (_tot_in + _tot_out) or ((_sys_c + _u_c + _a_c) // 4)
    _lines.append('  Context window: ~%d%% of 128K (model=%s)' % (min(100, (_ctx * 100) // 128000), _model))
    return chr(10).join(_lines)

# --- /export: export.tsx 深化（plain text .txt + smart filename + args 直写）---
# CC export.tsx:61 renderMessagesToPlainText（纯文本，非 markdown）；:21 extractFirstPrompt；
# :49 sanitizeFilename；:11 formatTimestamp(YYYY-MM-DD-HHMMSS)；:73 args → 直写指定文件名(.txt)
def _export():
    import os as _os, time as _t, re as _re
    _a = _agent()
    if not _a:
        return 'No agent.'
    # CC renderMessagesToPlainText: 纯文本 [role]\n<content>
    _lines = []
    for _m in _a.messages:
        _role = _m.get('role', '?')
        if _role == 'system':
            continue
        _lines.append('[%s]' % ('user' if _role == 'user' else 'assistant'))
        _lines.append(str(_m.get('content', '')))
        _lines.append('')
    _content = chr(10).join(_lines)
    # CC export.tsx:73 args → 直写到指定文件名（强制 .txt）
    _arg = (_args or '').strip()
    if _arg:
        _fn = _arg if _arg.endswith('.txt') else (_re.sub(r'\.[^.]+$', '', _arg) + '.txt')
        _fp = _os.path.join(_os.getcwd(), _fn)
        with open(_fp, 'w', encoding='utf-8') as _f:
            _f.write(_content)
        return 'Conversation exported to: %s' % _fp
    # CC export.tsx:92 default filename = {timestamp}-{sanitized首问}.txt
    _ts = _t.strftime('%Y-%m-%d-%H%M%S')
    _first = ''
    for _m in _a.messages:
        if _m.get('role') == 'user':
            _first = str(_m.get('content', '')).split(chr(10))[0][:49]
            break
    _san = _re.sub(r'[^a-z0-9\s-]', '', _first.lower())
    _san = _re.sub(r'[\s-]+', '-', _san).strip('-')
    _fn = ('%s-%s.txt' % (_ts, _san)) if _san else ('conversation-%s.txt' % _ts)
    _fp = _os.path.join(_os.getcwd(), _fn)
    with open(_fp, 'w', encoding='utf-8') as _f:
        _f.write(_content)
    return 'Conversation exported to: %s (%d messages)' % (_fp, len(_a.messages))

# --- /undo: CC 无 /undo 命令；fileHistory 快照恢复（utils/fileHistory.ts analogue）深化 ---
# CC 的 undo 行为 = rewind checkpoint 恢复 tracked files 到某快照点（fileHistory snapshots + trackedFiles）。
# Nexa /undo = _CCPORT_FILE_HISTORY 快照恢复。深化：+ /undo list 列出 tracked files + 快照数。
def _undo():
    import os as _os, shutil as _shu
    _hist = globals().get('_CCPORT_FILE_HISTORY', {})
    _arg = (_args or '').strip()
    if _arg == 'list':
        if not _hist:
            return 'No file history snapshots. (snapshots created on Edit/Write via snapshot_file)'
        _lines = ['File history (tracked files: %d):' % len(_hist)]
        for _fp, _stack in _hist.items():
            _lines.append('  %s — %d snapshot(s)' % (_fp, len(_stack)))
        return chr(10).join(_lines)
    if not _hist:
        return 'Nothing to undo (no file history snapshots). Run /undo list to inspect.'
    # LIFO：恢复最近一个 tracked file 的最近快照
    for _fp in reversed(list(_hist.keys())):
        _stack = _hist[_fp]
        if _stack:
            _bak = _stack.pop()
            if _os.path.isfile(_bak):
                _shu.copy2(_bak, _fp)
                return 'Undo: restored %s from snapshot (%d remaining for this file).' % (_fp, len(_stack))
    return 'No snapshots to restore.'

# --- /review: review.ts (LOCAL_REVIEW_PROMPT, type=prompt) 深化 ---
# CC /review 是 prompt 命令：getPromptForCommand → LOCAL_REVIEW_PROMPT（agent 跑 gh pr list/view/diff + 结构化 review）。
# 本深化：忠实移植为 prompt 命令（__AS_PROMPT__ 路由到 agent），而非 dump git diff（CC 源无 diff-dump 行为）。
def _review():
    _pr = (_args or '').strip()
    _prompt = (
        'You are an expert code reviewer. Follow these steps:' + chr(10) +
        '1. If no PR number is provided in the args, run `gh pr list` to show open PRs' + chr(10) +
        '2. If a PR number is provided, run `gh pr view <number>` to get PR details' + chr(10) +
        '3. Run `gh pr diff <number>` to get the diff (if no gh/PR, fall back to `git diff`)' + chr(10) +
        '4. Analyze the changes and provide a thorough code review:' + chr(10) +
        '   - Overview of what the PR does' + chr(10) +
        '   - Code quality and style' + chr(10) +
        '   - Specific suggestions for improvements' + chr(10) +
        '   - Potential issues or risks' + chr(10) + chr(10) +
        'Keep your review concise but thorough. Focus on:' + chr(10) +
        '- Code correctness' + chr(10) +
        '- Following project conventions' + chr(10) +
        '- Performance implications' + chr(10) +
        '- Test coverage' + chr(10) +
        '- Security considerations' + chr(10) + chr(10) +
        'Format your review with clear sections and bullet points.' + chr(10) + chr(10) +
        'PR number: %s' % _pr
    )
    return '__AS_PROMPT__:' + _prompt

# --- /share: share conversation ---
def _share():
    import os as _os, time as _t
    _a = _agent()
    if not _a:
        return 'No agent.'
    _lines = ['# Claude Code Conversation', '']
    for _m in _a.messages:
        _role = _m.get('role', '?')
        if _role == 'system':
            continue
        _lines.append('## %s' % ('User' if _role == 'user' else 'Assistant'))
        _lines.append('')
        _lines.append(str(_m.get('content', '')))
        _lines.append('')
    _fname = 'shared-session-%d.md' % int(_t.time())
    with open(_fname, 'w', encoding='utf-8') as _f:
        _f.write(chr(10).join(_lines))
    return 'Shared session saved to %s (%d messages)' % (_fname, len(_a.messages))

# --- /git: CC 无 /git 命令（CC 用原生 git via Bash）；本命令为便利封装（自创，非 CC 源）---
# 深化：扩充子命令集（add/restore/checkout/fetch/rebase），默认 status --short。
def _git():
    import subprocess as _sp
    _sub = (_args or '').strip().split()
    _cmd = _sub[0] if _sub else 'status'
    _rest = _sub[1:] if len(_sub) > 1 else []
    _git_map = {
        'status': ['status', '--short'],
        'log': ['log', '--oneline', '--graph', '-n', '15'],
        'branch': ['branch', '-a'],
        'blame': ['blame'] + _rest,
        'stash': ['stash', 'list'] if not _rest else (['stash'] + _rest),
        'diff': ['diff'] + _rest,
        'show': ['show'] + _rest,
        'add': ['add'] + (_rest or ['-A']),
        'restore': ['restore'] + _rest,
        'checkout': ['checkout'] + _rest,
        'fetch': ['fetch'] + _rest,
        'pull': ['pull'] + _rest,
        'push': ['push'] + _rest,
        'merge': ['merge'] + _rest,
        'rebase': ['rebase'] + _rest,
        'cherry-pick': ['cherry-pick'] + _rest,
        'commit': ['commit'] + _rest,
    }
    _args_list = _git_map.get(_cmd)
    if _args_list is None:
        return 'Unknown git subcommand: %s\nAvailable: %s' % (_cmd, ', '.join(sorted(_git_map.keys())))
    try:
        _p = _sp.run(['git'] + _args_list, capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=15)
        _out = (_p.stdout or '').strip()
        if not _out:
            _out = '(%s: no output, exit %d)' % (_cmd, _p.returncode)
        return _out
    except Exception as _e:
        return 'git %s failed: %s' % (_cmd, _e)

# --- /mcp add/remove/list enhancement ---
def _mcp_manage():
    import json as _j, os as _os
    _sub = (_args or '').strip().split(None, 2)
    _cfg_path = _os.path.join(_os.getcwd(), '.mcp.json')
    _cfg = {}
    if _os.path.isfile(_cfg_path):
        try:
            with open(_cfg_path, 'r') as _f:
                _cfg = _j.load(_f) or {}
        except Exception:
            pass
    _servers = _cfg.get('mcpServers', {})
    if not _sub or _sub[0] == 'list':
        if not _servers:
            return 'MCP: no servers configured.'
        _lines = ['MCP servers (%d):' % len(_servers)]
        for _n, _c in _servers.items():
            _lines.append('  %s — %s' % (_n, _c.get('command', '?') if isinstance(_c, dict) else '?'))
        return chr(10).join(_lines)
    if _sub[0] == 'add' and len(_sub) >= 3:
        _name, _cmd_str = _sub[1], _sub[2]
        _parts = _cmd_str.split()
        _servers[_name] = {'command': _parts[0], 'args': _parts[1:] if len(_parts) > 1 else []}
        _cfg['mcpServers'] = _servers
        with open(_cfg_path, 'w') as _f:
            _j.dump(_cfg, _f, indent=2)
        return 'Added MCP server: %s (%s)' % (_name, _cmd_str)
    if _sub[0] == 'remove' and len(_sub) >= 2:
        _name = _sub[1]
        if _name in _servers:
            del _servers[_name]
            _cfg['mcpServers'] = _servers
            with open(_cfg_path, 'w') as _f:
                _j.dump(_cfg, _f, indent=2)
            return 'Removed MCP server: %s' % _name
        return 'Server not found: %s' % _name
    return 'Usage: /mcp [list|add <name> <command>|remove <name>]'

# --- /pr: commit-push-pr.ts (type=prompt, Git Safety Protocol + allowedTools) 深化 ---
# CC /pr 是 prompt 命令：getPromptContent → 结构化 commit-push-pr 流程 + Git Safety Protocol。
# 本深化：忠实移植为 prompt 命令（agent 执行 branch→commit→push→gh pr create/edit），而非直接 subprocess（CC 源无直接执行）。
def _pr():
    _extra = (chr(10) + chr(10) + '## Additional instructions from user' + chr(10) + chr(10) + _args.strip()) if (_args or '').strip() else ''
    _prompt = (
        '## Context' + chr(10) +
        '- `git status`: run `git status`' + chr(10) +
        '- `git diff HEAD`: run `git diff HEAD`' + chr(10) +
        '- `git branch --show-current`: run `git branch --show-current`' + chr(10) + chr(10) +
        '## Git Safety Protocol' + chr(10) +
        '- NEVER update the git config' + chr(10) +
        '- NEVER run destructive/irreversible git commands (push --force, hard reset) unless explicitly requested' + chr(10) +
        '- NEVER skip hooks (--no-verify, --no-gpg-sign) unless explicitly requested' + chr(10) +
        '- NEVER force push to main/master' + chr(10) +
        '- Do not commit files that likely contain secrets (.env, credentials.json)' + chr(10) +
        '- Never use git commands with the -i flag (git rebase -i / git add -i)' + chr(10) + chr(10) +
        '## Your task' + chr(10) +
        'Analyze all changes that will be included in the pull request (look at ALL commits from the diff, not just the latest).' + chr(10) +
        '1. If on the default branch (main/master), create a new branch first (e.g. username/feature-name)' + chr(10) +
        '2. Create a single commit with an appropriate message using heredoc syntax' + chr(10) +
        '3. Push the branch to origin' + chr(10) +
        '4. If a PR already exists for this branch, update it with `gh pr edit`; otherwise create one with `gh pr create --title "<short>" --body "## Summary\\n<bullets>\\n\\n## Test plan\\n<checklist>"`' + chr(10) +
        '   - Keep PR titles short (under 70 characters). Use the body for details.' + chr(10) +
        'Return the PR URL when done.' + _extra
    )
    return '__AS_PROMPT__:' + _prompt

# --- /login: login/getAuthStatus.ts 深化（auth status + masked key preview）---
# CC getAuthStatus: subscription/workspaceKey 状态 + keyPreview masked（sk-a...67 (48 chars)；短 key [redacted] (N chars)）。
# 安全契约：API key 永不 raw，仅 masked preview。Nexa 适配：读 secrets.nxs 显示 provider/base_url/key(masked)/model。
def _login():
    import os as _os, json as _j
    _a = _agent()
    _sf = _os.path.join(_os.getcwd(), 'secrets.nxs')
    _base = _key = _model = ''
    if _os.path.isfile(_sf):
        try:
            with open(_sf, 'r', encoding='utf-8') as _f:
                _sec = _j.load(_f)
            _base = _sec.get('BASE_URL', '')
            _key = _sec.get('API_KEY', '')
            _mn = _sec.get('MODEL_NAME', '')
            _model = _mn.get('default', '') if isinstance(_mn, dict) else str(_mn)
        except Exception:
            pass
    def _maskkey(_k):
        if not _k:
            return '(not set)'
        if len(_k) < 20:
            return '[redacted] (%d chars)' % len(_k)
        return '%s...%s (%d chars)' % (_k[:4], _k[-2:], len(_k))
    _lines = ['Auth status:',
              '  Provider: GLM (OpenAI-compatible coding endpoint)',
              '  Base URL: %s' % (_base or '(not set)'),
              '  API key: %s' % _maskkey(_key),
              '  Model: %s' % (_model or (_a.model if _a else '?')),
              '  Mode: %s' % globals().get('_CCPORT_MODE', 'default'),
              '',
              'Switch provider: edit secrets.nxs BASE_URL + API_KEY + MODEL_NAME',
              'Supported: GLM / OpenAI-compatible / DeepSeek / Anthropic']
    return chr(10).join(_lines)

# --- /feedback: feedback/feedback.tsx 深化（CC 是 Feedback UI 表单→发 Anthropic；Nexa 本地保存适配）---
# CC /feedback: Feedback 组件 UI 表单（description + messages）→ 发送 Anthropic。Nexa 适配：本地保存（无后端）+ 附 session 摘要。partial（UI 表单平台层）。
def _feedback():
    import os as _os, time as _t
    _fb_dir = _os.path.join(_os.path.expanduser('~'), '.claude', 'feedback')
    _os.makedirs(_fb_dir, exist_ok=True)
    _fb_file = _os.path.join(_fb_dir, 'feedback-%d.txt' % int(_t.time()))
    _a = _agent()
    _msgs = _a.messages if _a else []
    with open(_fb_file, 'w', encoding='utf-8') as _f:
        _f.write('Feedback: %s\n' % (_args or '(no description)'))
        _f.write('Session messages: %d\n' % len(_msgs))
        _f.write('Model: %s\n' % (_a.model if _a else '?'))
    return 'Feedback recorded: %s (saved locally; CC sends to Anthropic via UI form — platform layer).' % _fb_file

# --- /keybindings: keybindings/keybindings.ts 深化（创建配置文件 template + 显示快捷键）---
# CC keybindings.ts: 写 template 到 keybindings 配置文件 + $EDITOR 打开。Nexa 适配：写 ~/.claude/keybindings + 显示清单。
def _keybindings():
    import os as _os
    _kb_path = _os.path.join(_os.path.expanduser('~'), '.claude', 'keybindings')
    _existed = _os.path.isfile(_kb_path)
    try:
        _os.makedirs(_os.path.dirname(_kb_path), exist_ok=True)
        if not _existed:
            _template = (chr(10).join(['# Claude Code (Nexa port) keybindings — customize as needed',
                '# Format: key=action', 'ctrl+c=quit', 'shift+tab=cycle_permission_mode',
                'esc=interrupt_turn', 'ctrl+j=newline', 'up=history_prev', 'down=history_next', 'tab=complete', '']))
            with open(_kb_path, 'w', encoding='utf-8') as _f:
                _f.write(_template)
        _msg = ('Opened %s in your editor.' if _existed else 'Created %s with template — open in $EDITOR to customize.') % _kb_path
    except Exception as _e:
        _msg = 'Could not create keybindings file: %s' % _e
    _lines = ['Keybindings:', _msg, '', 'Available shortcuts:',
              '  Ctrl+C: Quit (double-press)', '  Shift+Tab: Cycle permission mode',
              '  Esc: Interrupt turn', '  Ctrl+J: New line',
              '  Up/Down: History', '  Tab: Complete command']
    return chr(10).join(_lines)

# --- /release-notes: release-notes/release-notes.ts 深化（version:notes 格式 + CHANGELOG.md fallback）---
# CC release-notes.ts: fetch changelog(500ms) → "Version X:\n· note"；fallback cached → URL。Nexa 适配：读 CHANGELOG.md 格式化。
def _release_notes():
    import os as _os, re as _re
    _cf = _os.path.join(_os.getcwd(), 'CHANGELOG.md')
    if _os.path.isfile(_cf):
        try:
            with open(_cf, 'r', encoding='utf-8') as _f:
                _raw = _f.read()
            _sections = _re.split(r'^#{2,3}\s+', _raw, flags=_re.M)
            _out = []
            for _sec in _sections[1:6]:
                _lines = [_ln for _ln in _sec.strip().split(chr(10)) if _ln.strip()]
                if not _lines:
                    continue
                _out.append('Version %s:' % _lines[0].strip())
                for _ln in _lines[1:]:
                    if _ln.strip().startswith(('-', '*')):
                        _out.append('· %s' % _ln.lstrip('-* ').strip())
                _out.append('')
            if _out:
                return chr(10).join(_out)
        except Exception:
            pass
    _vf = _os.path.join(_os.getcwd(), 'VERSION')
    _v = open(_vf).read().strip() if _os.path.isfile(_vf) else '?'
    return 'Claude Code (Nexa port) v%s\nSee CHANGELOG.md (CC upstream: https://code.claude.com/docs/en/release-notes).' % _v

# --- /screenshot: capture terminal ---
def _screenshot():
    import sys as _sys, subprocess as _sp, os as _os, time as _t
    _fp = 'screenshot-%d.png' % int(_t.time())
    try:
        if _sys.platform == 'darwin':
            _sp.run(['screencapture', _fp], timeout=10)
        elif _sys.platform == 'win32':
            return 'Use Win+Shift+S on Windows.'
        else:
            _sp.run(['import', '-window', 'root', _fp], timeout=10)
        return 'Screenshot: %s (%d bytes)' % (_fp, _os.path.getsize(_fp)) if _os.path.isfile(_fp) else 'Screenshot failed.'
    except Exception as _e:
        return 'Screenshot failed: %s' % _e

# --- /terminal-setup: terminal tips ---
def _terminal_setup():
    return chr(10).join(['Terminal Setup:', '  Font: monospace with Unicode (for ⏺ ⎽ glyphs)',
              '  Color: 256-color or truecolor', '  Shift+Tab: permission modes', '  Ctrl+J: new line'])

# --- /bug: CC 无 /bug 命令（自创）；本地保存 bug report + 系统 info ---
def _bug():
    import os as _os, time as _t, sys as _sys, subprocess as _sp
    _bf = _os.path.join(_os.path.expanduser('~'), '.claude', 'bug-reports')
    _os.makedirs(_bf, exist_ok=True)
    _f = _os.path.join(_bf, 'bug-%d.txt' % int(_t.time()))
    _branch = ''
    try:
        _branch = (_sp.run(['git', 'branch', '--show-current'], capture_output=True, text=True, timeout=5).stdout or '').strip()
    except Exception:
        pass
    with open(_f, 'w', encoding='utf-8') as _fh:
        _fh.write('Bug description: %s\n' % (_args or '(no description)'))
        _fh.write('--- System info ---\n')
        _fh.write('Python: %s\nPlatform: %s\nGit branch: %s\n' % (_sys.version.split()[0], _sys.platform, _branch or '(none)'))
    return 'Bug report saved: %s (CC has no /bug command; Nexa self-created convenience.)' % _f

# --- /install: install.tsx 深化（CC 是 claude binary 自安装/升级；Nexa 适配为包安装便利，自创）---
# CC /install: nativeInstaller 安装/升级 claude binary 本身（平台层 binary 自安装）。
# Nexa 适配：pip/bun 包安装便利（@scope→bun add，否则 pip install）。诚实标注非 CC 源。
def _install():
    import subprocess as _sp
    _pkg = (_args or '').strip()
    if not _pkg:
        return 'Usage: /install <package>\n(CC /install upgrades the claude binary itself — platform layer; this Nexa command installs pip/bun packages, a self-created convenience.)'
    _cmd = (['bun', 'add', _pkg] if _pkg.startswith('@') else ['pip', 'install', _pkg])
    try:
        _r = _sp.run(_cmd, capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=120)
        _out = ((_r.stdout or '') + (_r.stderr or '')).strip()
        return '%s %s: %s' % (_cmd[0], _pkg, _out[:300])
    except Exception as _e:
        return 'Install failed: %s' % _e

# --- /plugin: plugin management (stub) ---
def _plugin():
    return 'Plugins: none. Use /install for packages. (Marketplace is platform feature.)'

# --- /diff: diff/diff.tsx 深化（CC 是 DiffDialog UI；Nexa 适配 git diff 文本）---
# CC /diff: DiffDialog 组件（UI 显示消息/文件 diff）。Nexa 适配：git diff 文本（支持 args 传 path/ref）。
def _diff():
    import subprocess as _sp
    _diff_args = (_args or '').strip().split() if _args else []
    try:
        _r = _sp.run(['git', 'diff'] + _diff_args, capture_output=True, text=True, encoding='utf-8', errors='replace', timeout=15)
        _out = (_r.stdout or '').strip()
        return _out[:3000] if _out else '(no changes)'
    except Exception as _e:
        return 'git diff failed: %s' % _e

# --- /hooks: hooks (深化版 — 对齐 CC HooksConfigMenu: add/remove/test/list) ---
# CC: commands/hooks/hooks.tsx → HooksConfigMenu (interactive editor)
# + utils/hooks.ts: HookEvent + getHooksConfig (merge from all settings sources)
# 深化：list/add/remove/test 子命令，多源合并读取，持久化写入 settings.local.json
def _hooks():
    import json as _j, os as _os, subprocess as _sp
    _VALID_EVENTS = {'PreToolUse', 'PostToolUse', 'UserPromptSubmit', 'Stop'}
    _target = _os.path.join(_os.getcwd(), '.claude', 'settings.local.json')
    _home = _os.path.expanduser('~')

    def _load_merged():
        _cfg = {}
        for _p in (_os.path.join(_home, '.claude', 'settings.json'),
                   _os.path.join(_os.getcwd(), '.claude', 'settings.json'),
                   _target):
            if _os.path.isfile(_p):
                try:
                    with open(_p, 'r') as _f:
                        _h = (_j.load(_f) or {}).get('hooks', {})
                        for _e, _entries in (_h or {}).items():
                            _cfg.setdefault(_e, []).extend(_entries)
                except Exception:
                    pass
        return _cfg

    def _save_hooks(hooks):
        _data = {}
        os.makedirs(_os.path.dirname(_target), exist_ok=True) if _os.path.dirname(_target) else None
        if _os.path.isfile(_target):
            try:
                with open(_target, 'r') as _f:
                    _data = _j.load(_f) or {}
            except Exception:
                _data = {}
        _data['hooks'] = hooks
        with open(_target, 'w') as _f:
            _j.dump(_data, _f, indent=2)

    _parts = (_args or '').strip().split(None, 2)
    if not _parts or _parts[0] == 'list':
        _cfg = _load_merged()
        if not _cfg:
            return 'No hooks configured.\nUsage: /hooks add <event> <command>\nEvents: %s' % ', '.join(sorted(_VALID_EVENTS))
        _lines = ['Hooks:']
        for _e in sorted(_cfg.keys()):
            _entries = _cfg[_e]
            _lines.append('  %s (%d):' % (_e, len(_entries)))
            for _en in _entries:
                for _h in (_en.get('hooks') or []):
                    _lines.append('    [matcher=%s] %s' % (_en.get('matcher', '*'), _h.get('command', '?')[:80]))
        _lines.append('\nUsage: /hooks [list|add <event> <cmd>|remove <event> <cmd>|test <event>]')
        return chr(10).join(_lines)

    _action = _parts[0].lower()
    if _action == 'add' and len(_parts) >= 3:
        _event = _parts[1].strip()
        _cmd = _parts[2].strip()
        if _event not in _VALID_EVENTS:
            return 'Invalid event: %s\nValid events: %s' % (_event, ', '.join(sorted(_VALID_EVENTS)))
        _cfg = _load_merged()
        _cfg.setdefault(_event, []).append({'matcher': '', 'hooks': [{'type': 'command', 'command': _cmd}]})
        _save_hooks({k: _cfg[k] for k in _cfg})
        return 'Added hook: %s -> %s' % (_event, _cmd)

    if _action == 'remove' and len(_parts) >= 3:
        _event = _parts[1].strip()
        _cmd = _parts[2].strip()
        _cfg = _load_merged()
        if _event in _cfg:
            _before = len(_cfg[_event])
            _cfg[_event] = [_en for _en in _cfg[_event]
                            if not any(_h.get('command', '') == _cmd for _h in (_en.get('hooks') or []))]
            _save_hooks({k: _cfg[k] for k in _cfg})
            return 'Removed %d hook(s) from %s' % (_before - len(_cfg[_event]), _event)
        return 'No hooks for event %s' % _event

    if _action == 'test' and len(_parts) >= 2:
        _event = _parts[1].strip()
        if _event not in _VALID_EVENTS:
            return 'Invalid event: %s' % _event
        _r = run_hook_event(_event, '', '{}')
        return 'Hook test output for %s:\n%s' % (_event, _r or '(no hooks or no output)')

    return 'Usage: /hooks [list|add <event> <cmd>|remove <event> <cmd>|test <event>]\nEvents: %s' % ', '.join(sorted(_VALID_EVENTS))

# --- /history: history.ts 深化（CC 是 pipe/attach 子会话历史；Nexa 适配主会话，用 CC formatEntryType 格式）---
# CC history.ts: [HH:MM:SS] [TYPE] content (截断 200)；formatEntryType: PROMPT/ACK/AI/TOOL>/TOOL</DONE/ERROR；--last N。
# Nexa 消息无 per-entry timestamp → 用序号；role→TYPE 映射对齐 CC。
def _history():
    _a = _agent()
    _msgs = [m for m in (_a.messages if _a else []) if m.get('role') in ('user', 'assistant')]
    if not _msgs:
        return 'No history.'
    _limit = 20
    _arg = (_args or '').strip()
    _parts = _arg.split()
    if '--last' in _parts:
        _i = _parts.index('--last')
        if _i + 1 < len(_parts):
            try:
                _limit = max(1, int(_parts[_i + 1]))
            except ValueError:
                pass
    elif _arg.isdigit():
        _limit = max(1, int(_arg))
    _entries = _msgs[-_limit:]
    def _ftype(_role):
        # CC formatEntryType: assistant→[AI], user→[PROMPT]
        return '[AI]    ' if _role == 'assistant' else '[PROMPT]'
    _lines = ['History (%d/%d entries):' % (len(_entries), len(_msgs))]
    for _i, _m in enumerate(_entries):
        _content = str(_m.get('content', '')).replace(chr(10), ' ')
        if len(_content) > 200:
            _content = _content[:200] + '...'
        _lines.append('[%d] %s %s' % (_i + 1, _ftype(_m.get('role')), _content))
    return chr(10).join(_lines)

# --- /theme: theme/theme.tsx 深化（persist + arg + "Theme set to X"）---
# CC theme.tsx: ThemePicker → setTheme(setting) + persist; "Theme set to <setting>"。
# Nexa 适配：dark/light 可移植子集（CC ThemePicker 有更多主题）。
def _theme():
    _arg = (_args or '').strip().lower()
    if _arg in ('dark', 'light'):
        globals()['_CCPORT_THEME'] = _arg
        _persist_setting('theme', _arg)
        return 'Theme set to %s' % _arg
    _cur = globals().get('_CCPORT_THEME', 'dark')
    return 'Current theme: %s. Usage: /theme [dark|light] (CC ThemePicker has more themes; dark/light ported.)' % _cur

# --- /env: env/index.ts 深化（Runtime + 允许前缀 env vars + secret 脱敏）---
# CC /env: ## Runtime(platform/arch/cwd/pid/node/session) + ## Environment Variables(允许前缀) +
#   secret 脱敏(token/secret/password/api_key/auth/credential/jwt/session_id → XXXX…XX (N chars))。
def _env():
    import sys, os as _os, re as _re
    _a = _agent()
    # CC SECRET_KEY_PATTERNS
    _secret_re = _re.compile(r'token|secret|password|api[_-]?key|auth|private|credential|jwt|session[_-]?id', _re.I)
    # CC ENV_PREFIX_ALLOWLIST (+ NEXA_ for this runtime)
    _prefixes = ('CLAUDE_', 'FEATURE_', 'ANTHROPIC_', 'NEXA_', 'BUN_', 'NODE_', 'GEMINI_', 'OPENAI_', 'GROK_', 'CCR_', 'KAIROS_', 'BUGHUNTER_')
    def _mask(_v):
        if len(_v) <= 8:
            return '***'
        return '%s…%s (%d chars)' % (_v[:4], _v[-2:], len(_v))
    _env_lines = []
    for _k in sorted(_os.environ.keys()):
        if not _k.startswith(_prefixes):
            continue
        _v = _os.environ.get(_k, '')
        _disp = _mask(_v) if (_secret_re.search(_k) and _v) else _v
        _env_lines.append('  %s=%s' % (_k, _disp))
    _lines = ['## Runtime',
              '  platform:        %s' % sys.platform,
              '  cwd:             %s' % _os.getcwd(),
              '  pid:             %d' % _os.getpid(),
              '  python:          %s' % sys.version.split()[0],
              '  session:         %s' % globals().get('_CCPORT_SESSION_ID', 'n/a'),
              '  model:           %s' % (_a.model if _a else '?'),
              '',
              '## Environment Variables (allowlisted prefixes)']
    _lines.extend(_env_lines if _env_lines else ['  (no recognized env vars set)'])
    _lines.append('')
    _lines.append('_Secrets matching token/password/auth/api_key are masked. Set CLAUDE_* / FEATURE_* env vars to see them here._')
    return chr(10).join(_lines)

# --- /version: version.ts 深化（VERSION + build，对齐 CC "version this session is running"）---
# CC version.ts: `${VERSION} (built ${BUILD_TIME})` 或 VERSION；description=Print the version this session is running。
def _version():
    import os as _os
    _v = '?'
    _vf = _os.path.join(_os.getcwd(), 'VERSION')
    if _os.path.isfile(_vf):
        with open(_vf, 'r', encoding='utf-8') as _f:
            _v = _f.read().strip()
    _lt = globals().get('LOCAL_TOOLS', {})
    _ntools = len(_lt) if isinstance(_lt, dict) else 0
    return ('Claude Code (Nexa port) v%s' % _v + chr(10) +
            'Prints the version this session is running (not what autoupdate may have downloaded).' + chr(10) +
            'Runtime: %d tools registered, GLM coding endpoint.' % _ntools)

# --- /recap: recap/generateRecap.ts 深化（exact CC RECAP_PROMPT，语言感知，无工具）---
# CC generateRecap: RECAP_PROMPT_ZH（≤60 字，无 markdown，先 goal+task 再 next action，跳过根因/次要）。
# forked single-turn，无工具。本深化：用 exact CC zh prompt（用户中文）。
def _recap():
    _a = _agent()
    _msgs = [m for m in (_a.messages if _a else []) if m.get('role') in ('user', 'assistant')]
    if len(_msgs) < 3:
        return 'Not enough conversation to recap yet.'
    _recap_prompt = ('用户离开后回来了。用中文写 1-2 句话，不超过 60 字，无 markdown。'
                     '先说明高层目标和当前任务，再说明下一步操作。跳过根因分析和次要待办。')
    try:
        _c = _a._get_client()
        _transcript = chr(10).join('[%s] %s' % (m.get('role'), str(m.get('content'))[:300]) for m in _msgs)
        _resp = _c.chat.completions.create(model=_a.model, timeout=30,
            messages=[{'role': 'system', 'content': _recap_prompt}, {'role': 'user', 'content': _transcript}])
        return _resp.choices[0].message.content or '(empty)'
    except Exception as _e:
        return 'Recap failed: %s' % _e

# --- /summary: summary/index.ts 深化（SessionMemory 提取，区别于 /recap 的快速 blurb）---
# CC /summary: manuallyExtractSessionMemory → 写 summary.md 并显示。区别于 /recap（≤60 字 blurb）。
# Nexa 适配：生成详细 session summary + 持久化到 ~/.claude/session-summary.md。
def _summary():
    _a = _agent()
    _msgs = [m for m in (_a.messages if _a else []) if m.get('role') in ('user', 'assistant')]
    if not _msgs:
        return 'No messages to summarize.'
    _sum_prompt = ('Generate a structured session summary with sections:' + chr(10) +
                   '1. Goal: what the user is trying to accomplish' + chr(10) +
                   '2. Key decisions and changes made' + chr(10) +
                   '3. Current state and pending work' + chr(10) +
                   '4. Next steps' + chr(10) + 'Be concise. Use markdown headings.')
    try:
        _c = _a._get_client()
        _transcript = chr(10).join('[%s] %s' % (m.get('role'), str(m.get('content'))[:400]) for m in _msgs)
        _resp = _c.chat.completions.create(model=_a.model, timeout=60,
            messages=[{'role': 'system', 'content': _sum_prompt}, {'role': 'user', 'content': _transcript}])
        _content = _resp.choices[0].message.content or '(empty)'
        import os as _os
        _sf = _os.path.join(_os.path.expanduser('~'), '.claude', 'session-summary.md')
        try:
            with open(_sf, 'w', encoding='utf-8') as _f:
                _f.write(_content)
        except Exception:
            pass
        return 'Session summary updated.' + chr(10) + chr(10) + _content
    except Exception as _e:
        return 'Failed to generate session summary: %s' % _e

# --- /commit: commit.ts (type=prompt, Git Safety Protocol) 深化 ---
# CC /commit 是 prompt 命令：getPromptContent → Context + Git Safety Protocol + 单 commit 任务（heredoc，禁 amend）。
# 本深化：忠实移植为 prompt 命令（agent 分析 diff + 跟随 repo 风格 + heredoc commit），而非直接 subprocess。
def _commit():
    _extra = (chr(10) + chr(10) + 'Additional instructions from user:' + chr(10) + chr(10) + _args.strip()) if (_args or '').strip() else ''
    _prompt = (
        '## Context' + chr(10) +
        '- Current git status: run `git status`' + chr(10) +
        '- Current git diff (staged and unstaged): run `git diff HEAD`' + chr(10) +
        '- Current branch: run `git branch --show-current`' + chr(10) +
        '- Recent commits: run `git log --oneline -10`' + chr(10) + chr(10) +
        '## Git Safety Protocol' + chr(10) +
        '- NEVER update the git config' + chr(10) +
        '- NEVER skip hooks (--no-verify, --no-gpg-sign) unless explicitly requested' + chr(10) +
        '- CRITICAL: ALWAYS create NEW commits. NEVER use git commit --amend unless explicitly requested' + chr(10) +
        '- Do not commit files that likely contain secrets (.env, credentials.json)' + chr(10) +
        '- If there are no changes to commit, do not create an empty commit' + chr(10) +
        '- Never use git commands with the -i flag (git rebase -i / git add -i)' + chr(10) + chr(10) +
        '## Your task' + chr(10) +
        'Based on the above changes, create a single git commit:' + chr(10) +
        '1. Analyze all staged changes and draft a commit message — follow this repo commit style (see recent commits), summarize the nature (feature/fix/refactor/test/docs), focus on the why not the what, keep it concise (1-2 sentences).' + chr(10) +
        '2. Stage relevant files and create the commit with a clear message (use heredoc for multi-line).' + _extra
    )
    return '__AS_PROMPT__:' + _prompt

def _sessionstats():
    _a = _agent()
    _msgs = _a.messages if _a else []
    _chars = sum(len(str(m.get('content', ''))) for m in _msgs)
    return 'Stats:\n  Messages: %d\n  Chars: %d\n  Est tokens: %d' % (len(_msgs), _chars, _chars // 4)

# --- /effort: effort/effort.tsx 深化（low/medium/high/xhigh/max/auto + persist + env override + descriptions）---
# CC effort.tsx: executeEffort(auto/unset→unset+persist, level→set+persist); CLAUDE_CODE_EFFORT_LEVEL env 覆盖；
#   descriptions: low=Quick / medium=Balanced / high=Comprehensive / xhigh=Extended / max=Maximum / auto=default。
def _effort():
    _DESC = {'low': 'Quick, straightforward implementation',
             'medium': 'Balanced approach with standard testing',
             'high': 'Comprehensive implementation with extensive testing',
             'xhigh': 'Extended reasoning beyond high, short of max',
             'max': 'Maximum capability with deepest reasoning'}
    _arg = (_args or '').strip().lower()
    if _arg in ('help', '-h', '--help'):
        return ('Usage: /effort [low|medium|high|xhigh|max|auto]' + chr(10) + chr(10) + 'Effort levels:' + chr(10) +
                chr(10).join('- %s: %s' % (_k, _v) for _k, _v in _DESC.items()) +
                chr(10) + '- auto: Use the default effort level for your model')
    if _arg in ('', 'current', 'status'):
        _env = os.environ.get('CLAUDE_CODE_EFFORT_LEVEL', '').strip().lower()
        _cur = _env or globals().get('_CCPORT_EFFORT', 'auto')
        if _cur == 'auto':
            return 'Effort level: auto (currently high)'
        return 'Current effort level: %s (%s)' % (_cur, _DESC.get(_cur, ''))
    if _arg in ('auto', 'unset'):
        globals().pop('_CCPORT_EFFORT', None)
        _persist_setting('effortLevel', None)
        _env_raw = os.environ.get('CLAUDE_CODE_EFFORT_LEVEL', '')
        if _env_raw.strip():
            return 'Cleared effort from settings, but CLAUDE_CODE_EFFORT_LEVEL=%s still controls this session' % _env_raw
        return 'Effort level set to auto'
    if _arg not in _DESC:
        return 'Invalid argument: %s. Valid options are: low, medium, high, xhigh, max, auto' % (_args or '')
    globals()['_CCPORT_EFFORT'] = _arg
    _persist_setting('effortLevel', _arg)
    _env_raw = os.environ.get('CLAUDE_CODE_EFFORT_LEVEL', '')
    if _env_raw.strip().lower() and _env_raw.strip().lower() != _arg:
        return 'CLAUDE_CODE_EFFORT_LEVEL=%s overrides this session — clear it and %s takes over' % (_env_raw, _arg)
    return 'Set effort level to %s: %s' % (_arg, _DESC[_arg])

# --- /session: session.tsx 深化（CC 是 remote QR session；Nexa 适配本地 session 信息）---
# CC /session: 显示 remote session URL + QR（claude --remote）；非 remote 模式提示。
# Nexa 适配：显示本地 session（id/start/elapsed/messages/model/mode/cwd）+ 标注 CC 是 remote 专用。
def _session():
    import os as _os, time as _t
    _a = _agent()
    _msgs = _a.messages if _a else []
    _t0 = globals().get('_CCPORT_SESSION_T0')
    _elapsed = ('%ds' % int(_t.time() - _t0)) if _t0 else '?'
    _started = _t.strftime('%Y-%m-%d %H:%M', _t.localtime(_t0)) if _t0 else '?'
    _lines = ['Session info:',
              '  Session id: %s' % globals().get('_CCPORT_SESSION_ID', '(unset)'),
              '  Started: %s (elapsed %s)' % (_started, _elapsed),
              '  Messages: %d' % len(_msgs),
              '  Model: %s' % (_a.model if _a else '?'),
              '  Mode: %s' % globals().get('_CCPORT_MODE', 'default'),
              '  CWD: %s' % _os.getcwd(),
              '',
              '(CC /session shows a remote QR session for `claude --remote`; this is the local-session adaptation.)']
    return chr(10).join(_lines)

_DISPATCH = {
    'help': _help, 'clear': _clear, 'compact': _compact, 'model': _model,
    'cost': _cost, 'usage': _usage, 'stats': _usage, 'status': _status,
    'context': _context, 'config': _config, 'vim': _vim, 'fast': _fast,
    'rewind': _rewind, 'resume': _resume, 'exit': _exit, 'quit': _exit,
    'init': _init, 'doctor': _doctor, 'add-dir': _add_dir, 'memory': _memory,
    'permissions': _permissions, 'agents': _agents,
    'copy': _copy, 'export': _export,
    'undo': _undo, 'review': _review, 'share': _share, 'git': _git,
    'mcp': _mcp_manage, 'pr': _pr, 'login': _login,
    'feedback': _feedback, 'keybindings': _keybindings, 'release-notes': _release_notes,
    'screenshot': _screenshot, 'terminal-setup': _terminal_setup,
    'bug': _bug, 'install': _install, 'plugin': _plugin,
    'diff': _diff, 'hooks': _hooks, 'history': _history, 'theme': _theme,
    'env': _env, 'version': _version, 'recap': _recap, 'summary': _summary,
    'commit': _commit, 'effort': _effort, 'session': _session,
}
_handler = _DISPATCH.get(_name)
if _handler is None:
    return 'Unknown command: /%s. Type /help for available commands.' % _name
return _handler()
"""
}
