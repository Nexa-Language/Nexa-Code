{
  "name": "@nexa-language/code",
  "version": "2.4.0-dev.0",
  "private": true,
  "type": "module",
  "description": "Nexa Code terminal interface",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "node --import tsx src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "format": "prettier --write src tests *.json",
    "format:check": "prettier --check src tests *.json"
  },
  "dependencies": {
    "ink": "5.2.1",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "22.18.10",
    "@types/react": "18.3.31",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
